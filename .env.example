# Clerk Authentication
# Get your Publishable Key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx_replace_with_your_key
VITE_ENABLE_CLERK_AUTH=false

# API Configuration
VITE_API_URL=http://localhost:5176/api

# Gemini API (Optional - for AI features)
VITE_GEMINI_API_KEY=your_gemini_key_here

# Environment
VITE_ENV=development

# Fintech module (served by BankInsight.API after migration)
VITE_FINTECH_API_BASE_URL=http://localhost:5176
VITE_FINTECH_API_HEALTH_URL=http://localhost:5176/health
VITE_FINTECH_ADMIN_URL=https://localhost:7020
VITE_FINTECH_API_DOCS_URL=http://localhost:5176/swagger

# Fintech live provider configuration
FINTECH_WEBHOOK_SECRET=replace_with_shared_webhook_secret
FINTECH_PROVIDERS__WEBHOOK__SIGNATUREHEADERNAME=x-paystack-signature
FINTECH_PROVIDERS__MOBILEMONEY__MODE=Mock
FINTECH_PROVIDERS__MOBILEMONEY__BASEURL=https://sandbox.example-momo.local
FINTECH_PROVIDERS__MOBILEMONEY__APIKEY=replace_with_mobile_money_api_key
FINTECH_PROVIDERS__MOBILEMONEY__APIKEYHEADERNAME=X-API-Key
FINTECH_PROVIDERS__MOBILEMONEY__APIKEYPREFIX=
FINTECH_PROVIDERS__MOBILEMONEY__TIMEOUTSECONDS=30
FINTECH_PROVIDERS__MOBILEMONEY__PAYOUTPATH=/payouts/mobile-money
FINTECH_PROVIDERS__MOBILEMONEY__STATUSPATH=/payouts/mobile-money/{reference}
FINTECH_PROVIDERS__MOBILEMONEY__VALIDATIONPATH=/beneficiaries/mobile-money/validate
FINTECH_PROVIDERS__MOBILEMONEY__RECIPIENTPATH=
FINTECH_PROVIDERS__MOBILEMONEY__RESOLVEPATH=
FINTECH_PROVIDERS__MOBILEMONEY__PROVIDERCODE=bankinsight-momo
FINTECH_PROVIDERS__MOBILEMONEY__REFERENCEPREFIX=BI
FINTECH_PROVIDERS__BANKTRANSFER__MODE=Live
FINTECH_PROVIDERS__BANKTRANSFER__BASEURL=https://api.paystack.co
FINTECH_PROVIDERS__BANKTRANSFER__APIKEY=sk_test_replace_with_paystack_test_key
FINTECH_PROVIDERS__BANKTRANSFER__APIKEYHEADERNAME=Authorization
FINTECH_PROVIDERS__BANKTRANSFER__APIKEYPREFIX=Bearer
FINTECH_PROVIDERS__BANKTRANSFER__TIMEOUTSECONDS=30
FINTECH_PROVIDERS__BANKTRANSFER__PAYOUTPATH=/transfer
FINTECH_PROVIDERS__BANKTRANSFER__STATUSPATH=/transfer/verify/{reference}
FINTECH_PROVIDERS__BANKTRANSFER__VALIDATIONPATH=/bank/resolve?account_number={accountNumber}&bank_code={bankCode}
FINTECH_PROVIDERS__BANKTRANSFER__RECIPIENTPATH=/transferrecipient
FINTECH_PROVIDERS__BANKTRANSFER__RESOLVEPATH=/bank/resolve?account_number={accountNumber}&bank_code={bankCode}
FINTECH_PROVIDERS__BANKTRANSFER__SOURCEACCOUNT=balance
FINTECH_PROVIDERS__BANKTRANSFER__PROVIDERCODE=paystack-bank-gh
FINTECH_PROVIDERS__BANKTRANSFER__REFERENCEPREFIX=BI
FINTECH_PROVIDERS__CRYPTOCUSTODY__MODE=Mock
FINTECH_PROVIDERS__CRYPTOCUSTODY__BASEURL=https://sandbox.example-custody.local
FINTECH_PROVIDERS__CRYPTOCUSTODY__APIKEY=replace_with_custody_api_key
FINTECH_PROVIDERS__CRYPTOCUSTODY__APIKEYHEADERNAME=X-API-Key
FINTECH_PROVIDERS__CRYPTOCUSTODY__APIKEYPREFIX=
FINTECH_PROVIDERS__CRYPTOCUSTODY__TIMEOUTSECONDS=30
FINTECH_PROVIDERS__CRYPTOCUSTODY__ADDRESSPATH=/custody/addresses
FINTECH_PROVIDERS__CRYPTOCUSTODY__WITHDRAWALPATH=/custody/withdrawals
FINTECH_PROVIDERS__CRYPTOCUSTODY__STATUSPATH=/custody/transactions/{reference}
FINTECH_PROVIDERS__CRYPTOCUSTODY__PROVIDERCODE=bankinsight-custody
FINTECH_PROVIDERS__CRYPTOCUSTODY__REFERENCEPREFIX=BI

