{
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}",
    "HybridTransferDb": "${DB_CONNECTION_STRING}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "BankInsight",
    "Audience": "BankInsightAPI",
    "ExpirationMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "IpWhitelist": {
      "Enabled": false,
      "AllowedIps": []
    },
    "SuspiciousActivity": {
      "LargeTransactionThreshold": 100000
    }
  },
  "SmtpSettings": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "alerts@bankinsight.local",
    "Recipients": [],
    "TimeoutSeconds": 30
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "FintechProviders": {
    "MobileMoney": {
      "Mode": "Mock",
      "BaseUrl": "",
      "ApiKey": "",
      "ApiKeyHeaderName": "X-API-Key",
      "ApiKeyPrefix": "",
      "TimeoutSeconds": 30,
      "PayoutPath": "/payouts/mobile-money",
      "StatusPath": "/payouts/mobile-money/{reference}",
      "ValidationPath": "/beneficiaries/mobile-money/validate",
      "RecipientPath": "",
      "ResolvePath": "",
      "ProviderCode": "bankinsight-momo",
      "ReferencePrefix": "BI"
    },
    "BankTransfer": {
      "Mode": "Mock",
      "BaseUrl": "",
      "ApiKey": "",
      "ApiKeyHeaderName": "X-API-Key",
      "ApiKeyPrefix": "",
      "TimeoutSeconds": 30,
      "PayoutPath": "/payouts/bank",
      "StatusPath": "/payouts/bank/{reference}",
      "ValidationPath": "/beneficiaries/bank/validate",
      "RecipientPath": "/transferrecipient",
      "ResolvePath": "/bank/resolve?account_number={accountNumber}&bank_code={bankCode}",
      "SourceAccount": "balance",
      "ProviderCode": "bankinsight-bank",
      "ReferencePrefix": "BI"
    },
    "CryptoCustody": {
      "Mode": "Mock",
      "BaseUrl": "",
      "ApiKey": "",
      "ApiKeyHeaderName": "X-API-Key",
      "ApiKeyPrefix": "",
      "TimeoutSeconds": 30,
      "AddressPath": "/custody/addresses",
      "WithdrawalPath": "/custody/withdrawals",
      "StatusPath": "/custody/transactions/{reference}",
      "ProviderCode": "bankinsight-custody",
      "ReferencePrefix": "BI"
    },
    "Webhook": {
      "SharedSecret": "${FINTECH_WEBHOOK_SECRET}",
      "SignatureHeaderName": "x-paystack-signature"
    }
  },
  "FintechLedger": {
    "EnableAutoPostPendingExternalPayout": true,
    "EnableAutoPostBankSettlement": true,
    "EnableAutoPostBankReversal": true,
    "PendingPayoutLiabilityAccountId": "cccccccc-3333-3333-3333-333333333333",
    "BankSettlementAssetAccountId": "dddddddd-4444-4444-4444-444444444444"
  },
  "AllowedHosts": "*"
}


