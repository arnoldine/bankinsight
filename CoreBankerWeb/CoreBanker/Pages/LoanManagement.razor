@page "/loans"
@layout CoreBanker.Layouts.MainLayout

@inject CoreBanker.Services.LoanService LoanService
@inject CoreBanker.Services.ClientService ClientService
@inject CoreBanker.Services.AccountService AccountService

<MudStack Spacing="3">
    <MudPaper Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">Loan Management Hub</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Portfolio, origination, schedule, review, disbursement, and servicing workflows backed by the live loan APIs.</MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadWorkspaceAsync">Refresh</MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_isSuccess ? Severity.Success : Severity.Error)">@_message</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Active</MudText><MudText Typo="Typo.h5">@ActiveLoans.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Pending</MudText><MudText Typo="Typo.h5">@PendingLoans.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Outstanding</MudText><MudText Typo="Typo.h5">@FormatCurrency(TotalOutstanding)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Arrears</MudText><MudText Typo="Typo.h5">@ArrearsLoans.Count</MudText></MudPaper></MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 corebanker-friendly-guide" Elevation="0">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.subtitle2">1. Originate</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Choose customer and product, confirm KYC readiness, then run credit and schedule preview.</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.subtitle2">2. Review</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Appraise, approve, and prepare approved facilities for disbursement with maker-checker notes.</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.subtitle2">3. Operate</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Disburse approved facilities, assess penalties, and classify delinquent loans from one control panel.</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.subtitle2">4. Collect</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Post repayments from active accounts and inspect live schedule lines before or after collection.</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTabs Rounded="true" @bind-ActivePanelIndex="_activeTabIndex">
        <MudTabPanel Text="Portfolio">
            <MudGrid>
                <MudItem xs="12" lg="8">
                    <MudPaper Class="pa-4">
                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <MudTextField @bind-Value="_searchTerm" Label="Search by loan, customer, product, or PAR bucket" Variant="Variant.Outlined" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("PENDING")">Pending</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("APPRAISED")">Appraised</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("APPROVED")">Approved</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("ACTIVE")">Active</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("DISBURSED")">Disbursed</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("CLOSED")">Closed</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        @if (!_isLoading && !FilteredLoans.Any())
                        {
                            <MudPaper Class="pa-6 mt-4 corebanker-empty-state" Elevation="0">
                                <MudText Typo="Typo.h6">No loans match the current view</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Clear the search or status filter to return to the wider portfolio.</MudText>
                            </MudPaper>
                        }

                        @if (FilteredLoans.Any())
                        {
                            <MudTable T="CoreBanker.Services.LoanDto" Items="@FilteredLoans" Dense="true" Hover="true" Loading="@_isLoading" Class="mt-4">
                                <HeaderContent>
                                    <MudTh>Loan</MudTh>
                                    <MudTh>Customer</MudTh>
                                    <MudTh>Product</MudTh>
                                    <MudTh>Principal</MudTh>
                                    <MudTh>Outstanding</MudTh>
                                    <MudTh>PAR</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Loan">@context.Id</MudTd>
                                    <MudTd DataLabel="Customer">@GetCustomerLabel(context.Cif)</MudTd>
                                    <MudTd DataLabel="Product">@DisplayLoanProduct(context)</MudTd>
                                    <MudTd DataLabel="Principal">@FormatCurrency(context.Principal)</MudTd>
                                    <MudTd DataLabel="Outstanding">@FormatCurrency(context.OutstandingBalance ?? 0m)</MudTd>
                                    <MudTd DataLabel="PAR">@DisplayParBucket(context.ParBucket)</MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetStatusColor(NormalizeStatus(context.Status))">@NormalizeStatus(context.Status)</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenReview(context))">Review</MudButton>
                                            <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="@(() => OpenScheduleAsync(context.Id, true))">Schedule</MudButton>
                                            <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => OpenRepayment(context))">Repay</MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Selected Facility</MudText>
                        @if (_selectedLoan is null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Choose a loan from the portfolio to load schedule, repayment, and operations context.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2" Class="mt-3">
                                <div>
                                    <MudText Typo="Typo.body1">@_selectedLoan.Id</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetCustomerLabel(_selectedLoan.Cif)</MudText>
                                </div>
                                <MudGrid>
                                    <MudItem xs="6"><MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Product</MudText><MudText Typo="Typo.body2">@DisplayLoanProduct(_selectedLoan)</MudText></MudPaper></MudItem>
                                    <MudItem xs="6"><MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Status</MudText><MudText Typo="Typo.body2">@NormalizeStatus(_selectedLoan.Status)</MudText></MudPaper></MudItem>
                                    <MudItem xs="6"><MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Principal</MudText><MudText Typo="Typo.body2">@FormatCurrency(_selectedLoan.Principal)</MudText></MudPaper></MudItem>
                                    <MudItem xs="6"><MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Outstanding</MudText><MudText Typo="Typo.body2">@FormatCurrency(_selectedLoan.OutstandingBalance ?? _selectedLoan.Principal)</MudText></MudPaper></MudItem>
                                </MudGrid>
                                @if (!string.IsNullOrWhiteSpace(_selectedLoan.CollateralType))
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                        @($"Collateral {_selectedLoan.CollateralType} valued at {FormatCurrency(_selectedLoan.CollateralValue ?? 0m)}")
                                    </MudAlert>
                                }
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="@(() => OpenScheduleAsync(_selectedLoan.Id, true))">Open Schedule</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => OpenRepayment(_selectedLoan))">Collect</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => OpenOperations(_selectedLoan))">Operate</MudButton>
                                </MudStack>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Origination">
            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="CoreBanker.Services.ClientDto"
                                                 Label="Customer"
                                                 Variant="Variant.Outlined"
                                                 Value="@_selectedOriginationClient"
                                                 ValueChanged="OnSelectedOriginationClientChanged"
                                                 SearchFunc="SearchOriginationClientsAsync"
                                                 ToStringFunc="FormatClientOption"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" @bind-Value="_originationProductId" Label="Loan Product" Variant="Variant.Outlined">
                                    @foreach (var product in _loanProducts.Where(product => product.IsActive).OrderBy(product => product.Name))
                                    {
                                        <MudSelectItem T="string" Value="@product.Id">@($"{product.Name} ({product.Code})")</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudNumericField T="decimal" @bind-Value="_originationPrincipal" Label="Principal" Variant="Variant.Outlined" Min="0.01m" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Start Date" Variant="Variant.Outlined" Date="@_originationStartDateTime" DateChanged="OnOriginationDateChanged" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_originationClientReference" Label="Client Reference" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        @if (_originationCustomerProfile?.KycReadiness is not null)
                        {
                            <MudAlert Severity="@(_originationCustomerProfile.KycReadiness.IsReadyForLoanOrigination ? Severity.Success : Severity.Warning)" Dense="true" Variant="Variant.Outlined" Class="mt-4">
                                @if (_originationCustomerProfile.KycReadiness.IsReadyForLoanOrigination)
                                {
                                    <span>Customer KYC is verified for loan origination.</span>
                                }
                                else
                                {
                                    <span>Loan origination is blocked until these are verified: @string.Join(", ", _originationCustomerProfile.KycReadiness.MissingRequirements)</span>
                                }
                            </MudAlert>
                        }

                        @if (SelectedProduct is not null)
                        {
                            <MudPaper Class="pa-3 mt-4 mud-theme-surface">
                                <MudText Typo="Typo.subtitle2">@SelectedProduct.Name</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@($"{SelectedProduct.InterestMethod} | {SelectedProduct.RepaymentFrequency} | {SelectedProduct.TermInPeriods} period(s)")</MudText>
                                <MudText Typo="Typo.body2">@($"Limits {FormatCurrency(SelectedProduct.MinAmount)} - {FormatCurrency(SelectedProduct.MaxAmount)}")</MudText>
                            </MudPaper>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">Choose an active loan product to load limits and repayment behavior before submission.</MudAlert>
                        }

                        <MudStack Row="true" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="@(_isActionBusy || !CanRunCreditCheck)" OnClick="RunCreditCheckAsync">Check Credit</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@(_isActionBusy || !CanGeneratePreview)" OnClick="GenerateSchedulePreviewAsync">Preview Schedule</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isActionBusy || !CanSubmitOrigination)" OnClick="SubmitLoanApplicationAsync">Submit Application</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <MudStack Spacing="3">
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Credit Result</MudText>
                            @if (_creditResult is null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Run a bureau check to see score and recommendation.</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body1" Class="mt-2">@($"Score {_creditResult.Score} | {_creditResult.RiskBand}")</MudText>
                                <MudText Typo="Typo.body2">@_creditResult.Recommendation</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@($"{_creditResult.ProviderName} | {_creditResult.CheckedAt:dd MMM yyyy HH:mm}")</MudText>
                            }
                        </MudPaper>
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Schedule Preview</MudText>
                            @if (_schedulePreview is null || _schedulePreview.Lines.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Generate a preview to inspect the first repayment lines.</MudText>
                            }
                            else
                            {
                                <MudTable T="CoreBanker.Services.LoanScheduleLineDto" Items="@_schedulePreview.Lines.Take(6)" Dense="true" Hover="true" Class="mt-3">
                                    <HeaderContent>
                                        <MudTh>Period</MudTh>
                                        <MudTh>Due</MudTh>
                                        <MudTh>Installment</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Period">@context.Period</MudTd>
                                        <MudTd DataLabel="Due">@context.DueDate.ToString("dd MMM yyyy")</MudTd>
                                        <MudTd DataLabel="Installment">@FormatCurrency(context.Installment)</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudPaper>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Review">
            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudTable T="CoreBanker.Services.LoanDto" Items="@ReviewLoans" Dense="true" Hover="true" Loading="@_isLoading">
                            <HeaderContent>
                                <MudTh>Loan</MudTh>
                                <MudTh>Customer</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Outstanding</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Loan">@context.Id</MudTd>
                                <MudTd DataLabel="Customer">@GetCustomerLabel(context.Cif)</MudTd>
                                <MudTd DataLabel="Status">@NormalizeStatus(context.Status)</MudTd>
                                <MudTd DataLabel="Outstanding">@FormatCurrency(context.OutstandingBalance ?? context.Principal)</MudTd>
                                <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenReview(context))">Manage</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Review Action</MudText>
                        @if (_reviewLoan is null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Select a loan to appraise, approve, or route into disbursement.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2" Class="mt-2">
                                <div>
                                    <MudText Typo="Typo.body1">@_reviewLoan.Id</MudText>
                                    <MudText Typo="Typo.body2">@GetCustomerLabel(_reviewLoan.Cif)</MudText>
                                </div>
                                <MudGrid>
                                    <MudItem xs="6"><MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Status</MudText><MudText Typo="Typo.body2">@NormalizeStatus(_reviewLoan.Status)</MudText></MudPaper></MudItem>
                                    <MudItem xs="6"><MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Exposure</MudText><MudText Typo="Typo.body2">@FormatCurrency(_reviewLoan.OutstandingBalance ?? _reviewLoan.Principal)</MudText></MudPaper></MudItem>
                                </MudGrid>
                                <MudTextField @bind-Value="_reviewNotes" Label="Decision Notes" Variant="Variant.Outlined" Lines="4" FullWidth="true" />
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="@_isActionBusy" OnClick="AppraiseSelectedLoanAsync">Appraise</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@_isActionBusy" OnClick="ApproveSelectedLoanAsync">Approve</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" Disabled="@_isActionBusy" OnClick="SendSelectedLoanToOperations">Disbursement Desk</MudButton>
                                </MudStack>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Repayment">
            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudSelect T="string" @bind-Value="_repaymentLoanId" Label="Loan" Variant="Variant.Outlined">
                            @foreach (var loan in ActiveLoans)
                            {
                                <MudSelectItem T="string" Value="@loan.Id">@($"{loan.Id} | {GetCustomerLabel(loan.Cif)}")</MudSelectItem>
                            }
                        </MudSelect>
                        <MudAutocomplete T="CoreBanker.Services.AccountDto"
                                         Label="Settlement Account"
                                         Variant="Variant.Outlined"
                                         Class="mt-3"
                                         Value="@_selectedRepaymentAccount"
                                         ValueChanged="OnSelectedRepaymentAccountChanged"
                                         SearchFunc="SearchRepaymentAccountsAsync"
                                         ToStringFunc="FormatLoanAccountOption"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="false"
                                         Dense="true" />
                        <MudGrid Class="mt-1">
                            <MudItem xs="12" md="6"><MudNumericField T="decimal" @bind-Value="_repaymentAmount" Label="Amount" Variant="Variant.Outlined" Min="0.01m" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField @bind-Value="_repaymentReference" Label="Reference" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="@(_isActionBusy || !CanPostRepayment)" OnClick="PostRepaymentAsync">Post Repayment</MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Schedule Snapshot</MudText>
                        <MudTable T="CoreBanker.Services.LoanScheduleDto" Items="@SchedulePreviewRows" Dense="true" Hover="true" Loading="@_isScheduleLoading" Class="mt-3">
                            <HeaderContent>
                                <MudTh>Period</MudTh>
                                <MudTh>Due</MudTh>
                                <MudTh>Total</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Period">@context.Period</MudTd>
                                <MudTd DataLabel="Due">@context.DueDate.ToString("dd MMM yyyy")</MudTd>
                                <MudTd DataLabel="Total">@FormatCurrency(context.Total)</MudTd>
                                <MudTd DataLabel="Status">@context.Status</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Schedule">
            <MudGrid>
                <MudItem xs="12" lg="4">
                    <MudPaper Class="pa-4">
                        <MudSelect T="string" @bind-Value="_scheduleLoanId" Label="Loan" Variant="Variant.Outlined">
                            @foreach (var loan in _loans.OrderByDescending(loan => loan.DisbursementDate))
                            {
                                <MudSelectItem T="string" Value="@loan.Id">@($"{loan.Id} | {GetCustomerLabel(loan.Cif)}")</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Class="mt-3" Disabled="@string.IsNullOrWhiteSpace(_scheduleLoanId)" OnClick="LoadScheduleFromTabAsync">Load Schedule</MudButton>

                        @if (_selectedScheduleLoan is not null)
                        {
                            <MudStack Spacing="2" Class="mt-4">
                                <MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Customer</MudText><MudText Typo="Typo.body2">@GetCustomerLabel(_selectedScheduleLoan.Cif)</MudText></MudPaper>
                                <MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Facility</MudText><MudText Typo="Typo.body2">@FormatCurrency(_selectedScheduleLoan.OutstandingBalance ?? _selectedScheduleLoan.Principal)</MudText></MudPaper>
                                <MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Status</MudText><MudText Typo="Typo.body2">@NormalizeStatus(_selectedScheduleLoan.Status)</MudText></MudPaper>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="8">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Amortization Schedule</MudText>
                        <MudTable T="CoreBanker.Services.LoanScheduleDto" Items="@_selectedSchedule" Dense="true" Hover="true" Loading="@_isScheduleLoading" Class="mt-3">
                            <HeaderContent>
                                <MudTh>Period</MudTh>
                                <MudTh>Due</MudTh>
                                <MudTh>Principal</MudTh>
                                <MudTh>Interest</MudTh>
                                <MudTh>Total</MudTh>
                                <MudTh>Balance</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Period">@context.Period</MudTd>
                                <MudTd DataLabel="Due">@context.DueDate.ToString("dd MMM yyyy")</MudTd>
                                <MudTd DataLabel="Principal">@FormatCurrency(context.Principal)</MudTd>
                                <MudTd DataLabel="Interest">@FormatCurrency(context.Interest)</MudTd>
                                <MudTd DataLabel="Total">@FormatCurrency(context.Total)</MudTd>
                                <MudTd DataLabel="Balance">@FormatCurrency(context.Balance)</MudTd>
                                <MudTd DataLabel="Status">@context.Status</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">Select a loan to load its repayment schedule.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Operations">
            <MudGrid>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudSelect T="string" @bind-Value="_operationsLoanId" Label="Loan" Variant="Variant.Outlined">
                            @foreach (var loan in OperationsLoans)
                            {
                                <MudSelectItem T="string" Value="@loan.Id">@($"{loan.Id} | {GetCustomerLabel(loan.Cif)}")</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Class="mt-3" Disabled="@string.IsNullOrWhiteSpace(_operationsLoanId)" OnClick="LoadOperationsLoan">Load Facility</MudButton>

                        @if (_operationsLoan is not null)
                        {
                            <MudStack Spacing="2" Class="mt-4">
                                <MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Customer</MudText><MudText Typo="Typo.body2">@GetCustomerLabel(_operationsLoan.Cif)</MudText></MudPaper>
                                <MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Status</MudText><MudText Typo="Typo.body2">@NormalizeStatus(_operationsLoan.Status)</MudText></MudPaper>
                                <MudPaper Class="pa-3 mud-theme-surface"><MudText Typo="Typo.caption">Outstanding</MudText><MudText Typo="Typo.body2">@FormatCurrency(_operationsLoan.OutstandingBalance ?? _operationsLoan.Principal)</MudText></MudPaper>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="7">
                    <MudStack Spacing="3">
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Disbursement Desk</MudText>
                            @if (_operationsLoan is null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Select an approved or active facility to manage disbursement and servicing controls.</MudText>
                            }
                            else
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="CoreBanker.Services.AccountDto"
                                                         Label="Servicing Account"
                                                         Variant="Variant.Outlined"
                                                         Value="@_selectedOperationsServicingAccount"
                                                         ValueChanged="OnSelectedOperationsServicingAccountChanged"
                                                         SearchFunc="SearchOperationsAccountsAsync"
                                                         ToStringFunc="FormatLoanAccountOption"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="false"
                                                         Dense="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="CoreBanker.Services.AccountDto"
                                                         Label="Collateral Account"
                                                         Variant="Variant.Outlined"
                                                         Value="@_selectedOperationsCollateralAccount"
                                                         ValueChanged="OnSelectedOperationsCollateralAccountChanged"
                                                         SearchFunc="SearchOperationsAccountsAsync"
                                                         ToStringFunc="FormatLoanAccountOption"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="false"
                                                         Dense="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_operationsClientReference" Label="Client Reference" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Class="mt-4" Disabled="@(_isActionBusy || !CanDisburseOperationsLoan)" OnClick="DisburseOperationsLoanAsync">Disburse Loan</MudButton>
                            }
                        </MudPaper>

                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Penalty and Classification</MudText>
                            @if (_operationsLoan is null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Load a facility first to assess penalties or classify loan quality.</MudText>
                            }
                            else
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="12" md="4">
                                        <MudNumericField T="decimal" @bind-Value="_penaltyRate" Label="Penalty Rate %" Variant="Variant.Outlined" Min="0m" />
                                    </MudItem>
                                    <MudItem xs="12" md="8">
                                        <MudTextField @bind-Value="_penaltyReason" Label="Reason" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                                <MudStack Row="true" Spacing="2" Class="mt-4">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_isActionBusy || !CanAssessPenalty)" OnClick="AssessPenaltyAsync">Assess Penalty</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Info" Disabled="@(_isActionBusy || !CanClassifyLoan)" OnClick="ClassifyOperationsLoanAsync">Classify</MudButton>
                                </MudStack>

                                @if (_penaltyResult is not null)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-4">
                                        @($"Penalty {FormatCurrency(_penaltyResult.PenaltyAmount)} at {_penaltyResult.PenaltyRate}% for {_penaltyResult.DaysPastDue} day(s) past due.")
                                    </MudAlert>
                                }

                                @if (_classificationResult is not null)
                                {
                                    <MudPaper Class="pa-3 mt-4 mud-theme-surface">
                                        <MudText Typo="Typo.subtitle2">@($"BoG Tier {_classificationResult.BogTier}")</MudText>
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@($"{_classificationResult.DaysPastDue} day(s) past due")</MudText>
                                        <MudText Typo="Typo.body2">@($"Provisioning {FormatCurrency(_classificationResult.ProvisioningAmount)} at {_classificationResult.ProvisioningRate:P0}")</MudText>
                                    </MudPaper>
                                }
                            }
                        </MudPaper>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</MudStack>

@code {
    private const int PortfolioTabIndex = 0;
    private const int OriginationTabIndex = 1;
    private const int ReviewTabIndex = 2;
    private const int RepaymentTabIndex = 3;
    private const int ScheduleTabIndex = 4;
    private const int OperationsTabIndex = 5;

    private List<CoreBanker.Services.LoanDto> _loans = new();
    private List<CoreBanker.Services.LoanProductDefinitionDto> _loanProducts = new();
    private List<CoreBanker.Services.CreditProviderDto> _creditProviders = new();
    private List<CoreBanker.Services.LoanScheduleDto> _selectedSchedule = new();
    private readonly Dictionary<string, CoreBanker.Services.ClientDto> _clientSnapshots = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<CoreBanker.Services.AccountDto>> _customerAccountsCache = new(StringComparer.OrdinalIgnoreCase);
    private CoreBanker.Services.LoanScheduleGenerationResultDto? _schedulePreview;
    private CoreBanker.Services.CreditCheckDto? _creditResult;
    private CoreBanker.Services.LoanPenaltyDto? _penaltyResult;
    private CoreBanker.Services.LoanClassificationDto? _classificationResult;
    private CoreBanker.Services.LoanDto? _reviewLoan;
    private CoreBanker.Services.LoanDto? _selectedLoan;
    private CoreBanker.Services.LoanDto? _selectedScheduleLoan;
    private CoreBanker.Services.LoanDto? _operationsLoan;
    private CoreBanker.Services.ClientProfileDto? _originationCustomerProfile;
    private CoreBanker.Services.ClientDto? _selectedOriginationClient;
    private CoreBanker.Services.AccountDto? _selectedRepaymentAccount;
    private CoreBanker.Services.AccountDto? _selectedOperationsServicingAccount;
    private CoreBanker.Services.AccountDto? _selectedOperationsCollateralAccount;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _originationCustomerId = string.Empty;
    private string _originationProductId = string.Empty;
    private decimal _originationPrincipal;
    private string _originationClientReference = string.Empty;
    private DateOnly _originationStartDate = DateOnly.FromDateTime(DateTime.Today);
    private DateTime? _originationStartDateTime = DateTime.Today;
    private string _reviewNotes = string.Empty;
    private string _repaymentLoanId = string.Empty;
    private string _repaymentAccountId = string.Empty;
    private decimal _repaymentAmount;
    private string _repaymentReference = string.Empty;
    private string _scheduleLoanId = string.Empty;
    private string _operationsLoanId = string.Empty;
    private string _operationsServicingAccountId = string.Empty;
    private string _operationsCollateralAccountId = string.Empty;
    private string _operationsClientReference = string.Empty;
    private decimal _penaltyRate = 5m;
    private string _penaltyReason = "Past due penalty";
    private string _message = string.Empty;
    private bool _isSuccess;
    private bool _isLoading;
    private bool _isActionBusy;
    private bool _isScheduleLoading;
    private int _activeTabIndex;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceAsync();
    }

    private CoreBanker.Services.LoanProductDefinitionDto? SelectedProduct => _loanProducts.FirstOrDefault(product => product.Id == _originationProductId);
    private List<CoreBanker.Services.LoanDto> ActiveLoans => _loans.Where(loan => NormalizeStatus(loan.Status) is "ACTIVE" or "APPROVED" or "DISBURSED").OrderByDescending(loan => loan.DisbursementDate).ToList();
    private List<CoreBanker.Services.LoanDto> PendingLoans => _loans.Where(loan => NormalizeStatus(loan.Status) is "PENDING" or "PENDING_APPROVAL" or "APPRAISED").ToList();
    private List<CoreBanker.Services.LoanDto> ReviewLoans => _loans.Where(loan => NormalizeStatus(loan.Status) is "PENDING" or "PENDING_APPROVAL" or "APPRAISED" or "APPROVED").ToList();
    private List<CoreBanker.Services.LoanDto> OperationsLoans => _loans.Where(loan => NormalizeStatus(loan.Status) is "APPROVED" or "ACTIVE" or "DISBURSED").OrderByDescending(loan => loan.DisbursementDate).ToList();
    private List<CoreBanker.Services.LoanDto> ArrearsLoans => _loans.Where(loan => !string.IsNullOrWhiteSpace(loan.ParBucket) && loan.ParBucket.Trim() != "0" && loan.ParBucket.Trim() != "PAR_0").ToList();
    private decimal TotalOutstanding => ActiveLoans.Sum(loan => loan.OutstandingBalance ?? loan.Principal);
    private IEnumerable<CoreBanker.Services.LoanScheduleDto> SchedulePreviewRows => _selectedSchedule.Take(8);
    private string SelectedRepaymentCustomerId => _loans.FirstOrDefault(loan => loan.Id == _repaymentLoanId)?.Cif ?? string.Empty;
    private string SelectedOperationsCustomerId => _operationsLoan?.Cif ?? string.Empty;
    private bool CanRunCreditCheck => !string.IsNullOrWhiteSpace(_originationCustomerId);
    private bool CanGeneratePreview => SelectedProduct is not null && _originationPrincipal > 0m;
    private bool CanSubmitOrigination => !string.IsNullOrWhiteSpace(_originationCustomerId) && SelectedProduct is not null && _originationPrincipal >= SelectedProduct.MinAmount && _originationPrincipal <= SelectedProduct.MaxAmount && (_originationCustomerProfile?.KycReadiness?.IsReadyForLoanOrigination ?? false);
    private bool CanPostRepayment => !string.IsNullOrWhiteSpace(_repaymentLoanId) && !string.IsNullOrWhiteSpace(_repaymentAccountId) && _repaymentAmount > 0m;
    private bool CanDisburseOperationsLoan => _operationsLoan is not null && NormalizeStatus(_operationsLoan.Status) == "APPROVED";
    private bool CanAssessPenalty => _operationsLoan is not null && (_operationsLoan.OutstandingBalance ?? _operationsLoan.Principal) > 0m;
    private bool CanClassifyLoan => _operationsLoan is not null;

    private IEnumerable<CoreBanker.Services.LoanDto> FilteredLoans =>
        _loans.Where(loan =>
        {
            var matchesStatus = string.IsNullOrWhiteSpace(_statusFilter) || NormalizeStatus(loan.Status) == _statusFilter;
            if (!matchesStatus)
            {
                return false;
            }

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return true;
            }

            return new[] { loan.Id, loan.Cif, loan.ProductCode ?? string.Empty, loan.ProductName ?? string.Empty, loan.ParBucket, GetCustomerLabel(loan.Cif) }
                .Any(value => value.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        }).OrderByDescending(loan => loan.DisbursementDate);

    private async Task LoadWorkspaceAsync()
    {
        _isLoading = true;
        _message = string.Empty;

        try
        {
            var loansTask = LoanService.GetLoansAsync();
            var productsTask = LoanService.GetLoanProductsAsync();
            var providersTask = LoanService.GetCreditProvidersAsync();
            await Task.WhenAll(loansTask, productsTask, providersTask);

            _loans = loansTask.Result;
            _loanProducts = productsTask.Result;
            _creditProviders = providersTask.Result;
            _originationProductId = string.IsNullOrWhiteSpace(_originationProductId) ? _loanProducts.FirstOrDefault(product => product.IsActive)?.Id ?? string.Empty : _originationProductId;
            _selectedLoan = _selectedLoan is null ? _loans.FirstOrDefault() : _loans.FirstOrDefault(loan => loan.Id == _selectedLoan.Id) ?? _loans.FirstOrDefault();
            _reviewLoan = _reviewLoan is null ? ReviewLoans.FirstOrDefault() : ReviewLoans.FirstOrDefault(loan => loan.Id == _reviewLoan.Id) ?? _reviewLoan;
            _operationsLoan = _operationsLoan is null ? OperationsLoans.FirstOrDefault() : OperationsLoans.FirstOrDefault(loan => loan.Id == _operationsLoan.Id) ?? _operationsLoan;
            _selectedScheduleLoan = _selectedScheduleLoan is null ? _selectedLoan : _loans.FirstOrDefault(loan => loan.Id == _selectedScheduleLoan.Id) ?? _selectedScheduleLoan;
            await EnsureLoanCustomerSnapshotsAsync();
            await OnOriginationCustomerChangedAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnOriginationCustomerChangedAsync()
    {
        _creditResult = null;
        _schedulePreview = null;

        if (string.IsNullOrWhiteSpace(_originationCustomerId))
        {
            _originationCustomerProfile = null;
            _selectedOriginationClient = null;
            return;
        }

        try
        {
            _originationCustomerProfile = await ClientService.GetClientProfileAsync(_originationCustomerId);
            if (_originationCustomerProfile is not null)
            {
                RememberClient(new CoreBanker.Services.ClientDto
                {
                    Id = _originationCustomerProfile.Id,
                    Name = _originationCustomerProfile.Name,
                    Email = _originationCustomerProfile.Email,
                    Phone = _originationCustomerProfile.Phone,
                    Type = _originationCustomerProfile.Type,
                    KycLevel = _originationCustomerProfile.KycLevel,
                    RiskRating = _originationCustomerProfile.RiskRating,
                    Status = _originationCustomerProfile.Status,
                    GhanaCard = _originationCustomerProfile.GhanaCard,
                    DigitalAddress = _originationCustomerProfile.DigitalAddress,
                    CreatedAt = _originationCustomerProfile.CreatedAt
                });
            }
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _originationCustomerProfile = null;
            _isSuccess = false;
            _message = ex.Message;
        }
    }

    private async Task RunCreditCheckAsync()
    {
        _isActionBusy = true;
        try
        {
            _creditResult = await LoanService.CheckCreditAsync(new CoreBanker.Services.CheckCreditRequest
            {
                CustomerId = _originationCustomerId,
                ProviderName = _creditProviders.FirstOrDefault()?.ProviderName
            });
            _isSuccess = true;
            _message = _creditResult is null ? "Credit check completed." : $"Credit check returned score {_creditResult.Score}.";
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task GenerateSchedulePreviewAsync()
    {
        if (SelectedProduct is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            _schedulePreview = await LoanService.GenerateScheduleAsync(new CoreBanker.Services.GenerateLoanScheduleRequest
            {
                LoanProductId = SelectedProduct.Id,
                Principal = _originationPrincipal,
                AnnualInterestRate = SelectedProduct.AnnualInterestRate,
                TermInPeriods = SelectedProduct.TermInPeriods,
                InterestMethod = SelectedProduct.InterestMethod,
                RepaymentFrequency = SelectedProduct.RepaymentFrequency,
                ScheduleType = SelectedProduct.RepaymentFrequency,
                StartDate = _originationStartDate
            });
            _isSuccess = true;
            _message = "Schedule preview generated.";
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task SubmitLoanApplicationAsync()
    {
        if (SelectedProduct is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            var loan = await LoanService.ApplyLoanAsync(new CoreBanker.Services.ApplyLoanRequest
            {
                CustomerId = _originationCustomerId,
                LoanProductId = SelectedProduct.Id,
                Principal = _originationPrincipal,
                ClientReference = string.IsNullOrWhiteSpace(_originationClientReference) ? null : _originationClientReference
            });
            _isSuccess = true;
            _message = loan is null ? "Loan application submitted." : $"Loan {loan.Id} created successfully.";
            _originationCustomerId = string.Empty;
            _selectedOriginationClient = null;
            _originationPrincipal = 0m;
            _originationClientReference = string.Empty;
            _schedulePreview = null;
            _creditResult = null;
            await LoadWorkspaceAsync();
            if (loan is not null)
            {
                OpenReview(loan);
            }
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private void OpenReview(CoreBanker.Services.LoanDto loan)
    {
        _selectedLoan = loan;
        _reviewLoan = loan;
        _reviewNotes = string.Empty;
        _activeTabIndex = ReviewTabIndex;
    }

    private async Task AppraiseSelectedLoanAsync()
    {
        if (_reviewLoan is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            await LoanService.AppraiseLoanAsync(new CoreBanker.Services.AppraiseLoanRequest { LoanId = _reviewLoan.Id, Decision = "APPRAISED", Notes = _reviewNotes });
            _isSuccess = true;
            _message = $"Loan {_reviewLoan.Id} appraised successfully.";
            await LoadWorkspaceAsync();
            _reviewLoan = ReviewLoans.FirstOrDefault(loan => loan.Id == _reviewLoan.Id) ?? _reviewLoan;
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task ApproveSelectedLoanAsync()
    {
        if (_reviewLoan is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            await LoanService.ApproveLoanAsync(new CoreBanker.Services.ApproveLoanRequest { LoanId = _reviewLoan.Id, DecisionNotes = _reviewNotes });
            _isSuccess = true;
            _message = $"Loan {_reviewLoan.Id} approved successfully.";
            await LoadWorkspaceAsync();
            _reviewLoan = ReviewLoans.FirstOrDefault(loan => loan.Id == _reviewLoan.Id) ?? _reviewLoan;
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private void SendSelectedLoanToOperations()
    {
        if (_reviewLoan is null)
        {
            return;
        }

        OpenOperations(_reviewLoan);
    }

    private void OpenRepayment(CoreBanker.Services.LoanDto loan)
    {
        _selectedLoan = loan;
        _repaymentLoanId = loan.Id;
        _repaymentAccountId = string.Empty;
        _selectedRepaymentAccount = null;
        _repaymentAmount = loan.OutstandingBalance ?? loan.Principal;
        _activeTabIndex = RepaymentTabIndex;
        _ = OpenScheduleAsync(loan.Id, false);
    }

    private async Task PostRepaymentAsync()
    {
        _isActionBusy = true;
        try
        {
            await LoanService.RepayLoanAsync(new CoreBanker.Services.RepayLoanRequest
            {
                LoanId = _repaymentLoanId,
                AccountId = _repaymentAccountId,
                Amount = _repaymentAmount,
                ClientReference = string.IsNullOrWhiteSpace(_repaymentReference) ? null : _repaymentReference
            });
            _isSuccess = true;
            _message = $"Repayment posted to loan {_repaymentLoanId}.";
            await LoadWorkspaceAsync();
            await OpenScheduleAsync(_repaymentLoanId, false);
            _repaymentReference = string.Empty;
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task LoadScheduleFromTabAsync()
    {
        if (string.IsNullOrWhiteSpace(_scheduleLoanId))
        {
            return;
        }

        await OpenScheduleAsync(_scheduleLoanId, false);
    }

    private async Task OpenScheduleAsync(string loanId, bool switchTab)
    {
        _isScheduleLoading = true;
        try
        {
            _scheduleLoanId = loanId;
            _selectedScheduleLoan = _loans.FirstOrDefault(loan => loan.Id == loanId);
            _selectedLoan = _selectedScheduleLoan ?? _selectedLoan;
            _selectedSchedule = await LoanService.GetLoanScheduleAsync(loanId);
            if (switchTab)
            {
                _activeTabIndex = ScheduleTabIndex;
            }
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isScheduleLoading = false;
        }
    }

    private void OpenOperations(CoreBanker.Services.LoanDto loan)
    {
        _selectedLoan = loan;
        _operationsLoan = loan;
        _operationsLoanId = loan.Id;
        _operationsServicingAccountId = string.Empty;
        _operationsCollateralAccountId = string.Empty;
        _selectedOperationsServicingAccount = null;
        _selectedOperationsCollateralAccount = null;
        _operationsClientReference = string.Empty;
        _penaltyResult = null;
        _classificationResult = null;
        _activeTabIndex = OperationsTabIndex;
    }

    private void LoadOperationsLoan()
    {
        var loan = _loans.FirstOrDefault(item => item.Id == _operationsLoanId);
        if (loan is null)
        {
            return;
        }

        OpenOperations(loan);
    }

    private async Task DisburseOperationsLoanAsync()
    {
        if (_operationsLoan is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            await LoanService.DisburseLoanAsync(new CoreBanker.Services.DisburseApprovedLoanRequest
            {
                LoanId = _operationsLoan.Id,
                ClientReference = string.IsNullOrWhiteSpace(_operationsClientReference) ? $"COREBANKER-DSB-{DateTime.UtcNow:yyyyMMddHHmmss}" : _operationsClientReference,
                ServicingAccountId = string.IsNullOrWhiteSpace(_operationsServicingAccountId) ? null : _operationsServicingAccountId,
                CollateralAccountId = string.IsNullOrWhiteSpace(_operationsCollateralAccountId) ? null : _operationsCollateralAccountId
            });
            _isSuccess = true;
            _message = $"Loan {_operationsLoan.Id} disbursed successfully.";
            await LoadWorkspaceAsync();
            _operationsLoan = _loans.FirstOrDefault(loan => loan.Id == _operationsLoan.Id) ?? _operationsLoan;
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task AssessPenaltyAsync()
    {
        if (_operationsLoan is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            _penaltyResult = await LoanService.AssessPenaltyAsync(_operationsLoan.Id, new CoreBanker.Services.AssessLoanPenaltyRequest
            {
                PenaltyRate = _penaltyRate,
                Reason = string.IsNullOrWhiteSpace(_penaltyReason) ? null : _penaltyReason,
                ClientReference = string.IsNullOrWhiteSpace(_operationsClientReference) ? null : _operationsClientReference
            });
            _isSuccess = true;
            _message = _penaltyResult is null ? "Penalty assessment completed." : $"Penalty assessed at {FormatCurrency(_penaltyResult.PenaltyAmount)}.";
            await LoadWorkspaceAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task ClassifyOperationsLoanAsync()
    {
        if (_operationsLoan is null)
        {
            return;
        }

        _isActionBusy = true;
        try
        {
            _classificationResult = await LoanService.ClassifyLoanAsync(_operationsLoan.Id);
            _isSuccess = true;
            _message = _classificationResult is null ? "Loan classification completed." : $"Loan classified into {_classificationResult.BogTier}.";
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private void OnOriginationDateChanged(DateTime? value)
    {
        _originationStartDateTime = value;
        _originationStartDate = DateOnly.FromDateTime((value ?? DateTime.Today).Date);
    }

    private string GetCustomerLabel(string? customerId)
    {
        if (string.IsNullOrWhiteSpace(customerId))
        {
            return "Unknown customer";
        }

        var client = _clientSnapshots.TryGetValue(customerId, out var cachedClient) ? cachedClient : null;
        return client is null ? customerId : $"{client.Name} ({client.Id})";
    }

    private async Task<IEnumerable<CoreBanker.Services.ClientDto>> SearchOriginationClientsAsync(string value, CancellationToken cancellationToken)
    {
        var clients = await ClientService.SearchClientsAsync(value, 20, cancellationToken);
        foreach (var client in clients)
        {
            RememberClient(client);
        }

        return clients;
    }

    private async Task OnSelectedOriginationClientChanged(CoreBanker.Services.ClientDto? client)
    {
        _selectedOriginationClient = client;
        _originationCustomerId = client?.Id ?? string.Empty;
        RememberClient(client);
        await OnOriginationCustomerChangedAsync();
    }

    private async Task<IEnumerable<CoreBanker.Services.AccountDto>> SearchRepaymentAccountsAsync(string value, CancellationToken cancellationToken)
    {
        return await SearchAccountsForCustomerAsync(SelectedRepaymentCustomerId, value, cancellationToken);
    }

    private async Task<IEnumerable<CoreBanker.Services.AccountDto>> SearchOperationsAccountsAsync(string value, CancellationToken cancellationToken)
    {
        return await SearchAccountsForCustomerAsync(SelectedOperationsCustomerId, value, cancellationToken);
    }

    private Task OnSelectedRepaymentAccountChanged(CoreBanker.Services.AccountDto? account)
    {
        _selectedRepaymentAccount = account;
        _repaymentAccountId = account?.Id ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnSelectedOperationsServicingAccountChanged(CoreBanker.Services.AccountDto? account)
    {
        _selectedOperationsServicingAccount = account;
        _operationsServicingAccountId = account?.Id ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnSelectedOperationsCollateralAccountChanged(CoreBanker.Services.AccountDto? account)
    {
        _selectedOperationsCollateralAccount = account;
        _operationsCollateralAccountId = account?.Id ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task<IEnumerable<CoreBanker.Services.AccountDto>> SearchAccountsForCustomerAsync(string customerId, string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(customerId))
        {
            return Enumerable.Empty<CoreBanker.Services.AccountDto>();
        }

        if (!_customerAccountsCache.TryGetValue(customerId, out var accounts))
        {
            accounts = await AccountService.GetAccountsByCustomerIdAsync(customerId, cancellationToken);
            _customerAccountsCache[customerId] = accounts;
        }

        return accounts
            .Where(account => NormalizeStatus(account.Status) == "ACTIVE")
            .Where(account =>
                string.IsNullOrWhiteSpace(value)
                || account.Id.Contains(value, StringComparison.OrdinalIgnoreCase)
                || account.ProductCode.Contains(value, StringComparison.OrdinalIgnoreCase)
                || account.Currency.Contains(value, StringComparison.OrdinalIgnoreCase))
            .OrderBy(account => account.Id)
            .Take(20)
            .ToList();
    }

    private async Task EnsureLoanCustomerSnapshotsAsync()
    {
        var customerIds = _loans
            .Select(loan => loan.Cif)
            .Where(customerId => !string.IsNullOrWhiteSpace(customerId))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(customerId => !_clientSnapshots.ContainsKey(customerId))
            .Take(40)
            .ToList();

        foreach (var customerId in customerIds)
        {
            var matches = await ClientService.SearchClientsAsync(customerId, 5);
            var exactMatch = matches.FirstOrDefault(client => string.Equals(client.Id, customerId, StringComparison.OrdinalIgnoreCase));
            RememberClient(exactMatch ?? matches.FirstOrDefault());
        }
    }

    private void RememberClient(CoreBanker.Services.ClientDto? client)
    {
        if (client is null || string.IsNullOrWhiteSpace(client.Id))
        {
            return;
        }

        _clientSnapshots[client.Id] = client;
    }

    private static string FormatClientOption(CoreBanker.Services.ClientDto? client)
    {
        return client is null ? string.Empty : $"{client.Name} ({client.Id})";
    }

    private static string FormatLoanAccountOption(CoreBanker.Services.AccountDto? account)
    {
        return account is null ? string.Empty : $"{account.Id} | {FormatCurrency(account.AvailableBalance)}";
    }

    private static string DisplayLoanProduct(CoreBanker.Services.LoanDto loan)
    {
        return string.IsNullOrWhiteSpace(loan.ProductName) ? (loan.ProductCode ?? "Unknown product") : loan.ProductName;
    }

    private static string NormalizeStatus(string? status) => (status ?? string.Empty).Trim().ToUpperInvariant();

    private static Color GetStatusColor(string? status) =>
        status switch
        {
            "ACTIVE" or "APPROVED" or "DISBURSED" => Color.Success,
            "PENDING" or "PENDING_APPROVAL" or "APPRAISED" => Color.Warning,
            "CLOSED" => Color.Info,
            _ => Color.Default
        };

    private static string DisplayParBucket(string? parBucket) => string.IsNullOrWhiteSpace(parBucket) ? "PAR_0" : parBucket.Trim();
    private static string FormatCurrency(decimal amount) => CoreBanker.Utilities.CurrencyFormatter.Format(amount);
}
