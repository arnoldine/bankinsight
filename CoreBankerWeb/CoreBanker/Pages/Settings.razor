    private async Task SaveLeaseAsync()
    {
        if (string.IsNullOrWhiteSpace(_leaseForm.StaffId) || string.IsNullOrWhiteSpace(_leaseForm.Permission) || string.IsNullOrWhiteSpace(_leaseForm.Reason))
        {
            ShowError("Staff member, permission, and reason are required.");
            return;
        }

        if (!_leaseExpiryDate.HasValue)
        {
            ShowError("An expiry date is required.");
            return;
        }

        _isSavingLease = true;
        try
        {
            await AdminService.CreatePrivilegeLeaseAsync(new CoreBanker.Services.CreatePrivilegeLeaseRequest
            {
                StaffId = _leaseForm.StaffId,
                Permission = _leaseForm.Permission.Trim().ToUpperInvariant(),
                Reason = _leaseForm.Reason.Trim(),
                ApprovedBy = AppState.UserId ?? AppState.UserEmail ?? "system",
                StartsAt = _leaseStartDate?.Date,
                ExpiresAt = _leaseExpiryDate.Value.Date.AddHours(23).AddMinutes(59)
            });
            ShowSuccess("Privilege lease granted.");
            _leaseForm.Permission = string.Empty;
            _leaseForm.Reason = string.Empty;
            _leaseStartDate = DateTime.Today;
            _leaseExpiryDate = DateTime.Today.AddDays(7);
            await LoadSelectedUserLeasesAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _isSavingLease = false;
        }
    }

