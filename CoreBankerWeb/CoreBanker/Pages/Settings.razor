@page "/settings"
@layout CoreBanker.Layouts.MainLayout
@using System.Globalization
@inject CoreBanker.Services.AdminService AdminService
@inject CoreBanker.State.AppState AppState

<MudStack Spacing="3">
    <MudPaper Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">Settings & Control Room</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage platform policies, staff administration, branches, privilege leases, and ORASS readiness.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadWorkspaceAsync">Refresh</MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_success ? Severity.Success : Severity.Error)">@_message</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Credit Bureau</MudText><MudText Typo="Typo.h5">@(_snapshot.LoanCreditBureauRequiredForApproval ? "Mandatory" : "Optional")</MudText></MudPaper></MudItem>
        <MudItem xs="12" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Users</MudText><MudText Typo="Typo.h5">@_users.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">Branches</MudText><MudText Typo="Typo.h5">@_branches.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.caption">ORASS Pending</MudText><MudText Typo="Typo.h5">@(_orassReadiness?.PendingReturns ?? 0)</MudText></MudPaper></MudItem>
    </MudGrid>

    <MudTabs Rounded="true" Elevation="0">
        <MudTabPanel Text="Configuration">
            <MudGrid>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Operational Policies</MudText>
                        <MudCheckBox @bind-Value="_snapshot.LoanCreditBureauRequiredForApproval" Label="Require credit bureau for approvals" Class="mt-3" />
                        <MudTextField @bind-Value="_snapshot.ActiveCreditProvider" Label="Active Credit Provider" Variant="Variant.Outlined" Class="mt-3" />
                        <MudNumericField T="decimal?" @bind-Value="_snapshot.DefaultTransactionLimit" Label="Default Transaction Limit" Variant="Variant.Outlined" Class="mt-3" />
                        <MudCheckBox @bind-Value="_snapshot.EodSchedulerEnabled" Label="Enable EOD scheduler" Class="mt-3" />
                        <MudTextField @bind-Value="_snapshot.EodSchedulerTimeUtc" Label="EOD Time (UTC)" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField Value="@_snapshot.EodSchedulerLastRunDate" Label="Last EOD Run" Variant="Variant.Outlined" Disabled="true" Class="mt-3" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="@_isSavingConfig" OnClick="SaveConfigAsync">Save Configuration</MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Raw Key/Value Store</MudText>
                        <MudTable T="CoreBanker.Services.ConfigItemDto" Items="@_configItems" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent><MudTh>Key</MudTh><MudTh>Value</MudTh></HeaderContent>
                            <RowTemplate><MudTd DataLabel="Key">@context.Key</MudTd><MudTd DataLabel="Value">@context.Value</MudTd></RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Users">
            <MudGrid>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">@(_editingUserId is null ? "Create User" : "Edit User")</MudText>
                        <MudTextField @bind-Value="_userForm.Name" Label="Full Name" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField @bind-Value="_userForm.Email" Label="Email" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField @bind-Value="_userForm.Phone" Label="Phone" Variant="Variant.Outlined" Class="mt-3" />
                        <MudSelect T="string" @bind-Value="_userForm.RoleId" Label="Primary Role" Variant="Variant.Outlined" Class="mt-3">
                            @foreach (var role in _roles) { <MudSelectItem Value="@role.Id">@role.Name</MudSelectItem> }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_userForm.BranchId" Label="Branch" Variant="Variant.Outlined" Class="mt-3">
                            @foreach (var branch in _branches) { <MudSelectItem Value="@branch.Id">@($"{branch.Code} - {branch.Name}")</MudSelectItem> }
                        </MudSelect>
                        <MudTextField @bind-Value="_userForm.Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" HelperText="Required for new users. Leave blank during edits to keep the current password." Class="mt-3" />
                        @if (_editingUserId is not null)
                        {
                            <MudSelect T="string" @bind-Value="_userForm.Status" Label="Status" Variant="Variant.Outlined" Class="mt-3">
                                @foreach (var status in UserStatuses) { <MudSelectItem Value="@status">@status</MudSelectItem> }
                            </MudSelect>
                        }
                        <MudStack Row="true" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSavingUser" OnClick="SaveUserAsync">@(_editingUserId is null ? "Create User" : "Save User")</MudButton>
                            <MudButton Variant="Variant.Text" Disabled="@_isSavingUser" OnClick="ResetUserForm">Clear</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">User Directory</MudText>
                            <MudTextField @bind-Value="_userFilter" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudStack>
                        <MudTable T="CoreBanker.Services.AdminUserDto" Items="@FilteredUsers" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent><MudTh>Name</MudTh><MudTh>Email</MudTh><MudTh>Role</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">@context.Name</MudTd>
                                <MudTd DataLabel="Email">@context.Email</MudTd>
                                <MudTd DataLabel="Role">@GetRoleName(context.RoleIds.FirstOrDefault())</MudTd>
                                <MudTd DataLabel="Status">@context.Status</MudTd>
                                <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => EditUser(context))">Edit</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_isSavingUser" OnClick="@(() => DeleteUserAsync(context))">Delete</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Roles">
            <MudGrid>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">@(_editingRoleId is null ? "Create Role" : "Edit Role")</MudText>
                        <MudTextField @bind-Value="_roleForm.Name" Label="Role Name" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField @bind-Value="_roleForm.Description" Label="Description" Variant="Variant.Outlined" Lines="3" Class="mt-3" />
                        <MudTextField @bind-Value="_rolePermissionsInput" Label="Permissions" Variant="Variant.Outlined" Lines="5" HelperText="One permission per line, for example VIEW_USERS." Class="mt-3" />
                        <MudStack Row="true" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSavingRole" OnClick="SaveRoleAsync">@(_editingRoleId is null ? "Create Role" : "Save Role")</MudButton>
                            <MudButton Variant="Variant.Text" Disabled="@_isSavingRole" OnClick="ResetRoleForm">Clear</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Role Catalog</MudText>
                        <MudTable T="CoreBanker.Services.RoleSummaryDto" Items="@_roles" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent><MudTh>Role</MudTh><MudTh>Users</MudTh><MudTh>Permissions</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Role"><MudText Typo="Typo.body2">@context.Name</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Description</MudText></MudTd>
                                <MudTd DataLabel="Users">@context.UserCount</MudTd>
                                <MudTd DataLabel="Permissions">@string.Join(", ", context.Permissions.Take(4))@(context.Permissions.Count > 4 ? "..." : string.Empty)</MudTd>
                                <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => EditRole(context))">Edit</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Branches">
            <MudGrid>
                <MudItem xs="12" lg="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">@(_editingBranchId is null ? "Create Branch" : "Edit Branch")</MudText>
                        <MudTextField @bind-Value="_branchForm.Code" Label="Branch Code" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField @bind-Value="_branchForm.Name" Label="Branch Name" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField @bind-Value="_branchForm.Location" Label="Location" Variant="Variant.Outlined" Class="mt-3" />
                        <MudSelect T="string" @bind-Value="_branchForm.Status" Label="Status" Variant="Variant.Outlined" Class="mt-3">
                            @foreach (var status in UserStatuses) { <MudSelectItem Value="@status">@status</MudSelectItem> }
                        </MudSelect>
                        <MudStack Row="true" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSavingBranch" OnClick="SaveBranchAsync">@(_editingBranchId is null ? "Create Branch" : "Save Branch")</MudButton>
                            <MudButton Variant="Variant.Text" Disabled="@_isSavingBranch" OnClick="ResetBranchForm">Clear</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="8">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Branch Registry</MudText>
                        <MudTable T="CoreBanker.Services.BranchDto" Items="@_branches" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Location</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Code">@context.Code</MudTd>
                                <MudTd DataLabel="Name">@context.Name</MudTd>
                                <MudTd DataLabel="Location">@context.Location</MudTd>
                                <MudTd DataLabel="Status">@context.Status</MudTd>
                                <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => EditBranch(context))">Edit</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_isSavingBranch" OnClick="@(() => DeleteBranchAsync(context))">Delete</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Privilege Leases">
            <MudGrid>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Grant Temporary Privilege</MudText>
                        <MudSelect T="string" @bind-Value="_leaseForm.StaffId" Label="Staff Member" Variant="Variant.Outlined" Class="mt-3" OnClosed="LoadSelectedUserLeasesAsync">
                            @foreach (var user in _users) { <MudSelectItem Value="@user.Id">@($"{user.Name} ({user.Email})")</MudSelectItem> }
                        </MudSelect>
                        <MudTextField @bind-Value="_leaseForm.Permission" Label="Permission" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField @bind-Value="_leaseForm.Reason" Label="Reason" Variant="Variant.Outlined" Lines="3" Class="mt-3" />
                        <MudDatePicker @bind-Date="_leaseStartDate" Label="Starts On" Class="mt-3" />
                        <MudDatePicker @bind-Date="_leaseExpiryDate" Label="Expires On" Class="mt-3" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSavingLease" Class="mt-4" OnClick="SaveLeaseAsync">Grant Privilege</MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">Active Leases</MudText>
                            <MudButton Variant="Variant.Outlined" Disabled="@string.IsNullOrWhiteSpace(_leaseForm.StaffId)" OnClick="LoadSelectedUserLeasesAsync">Refresh Staff Leases</MudButton>
                        </MudStack>
                        @if (string.IsNullOrWhiteSpace(_leaseForm.StaffId))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Select a staff member to inspect or revoke temporary privileges.</MudText>
                        }
                        else
                        {
                            <MudTable T="CoreBanker.Services.PrivilegeLeaseDto" Items="@_selectedUserLeases" Dense="true" Hover="true" Class="mt-3">
                                <HeaderContent><MudTh>Permission</MudTh><MudTh>Window</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Permission"><MudText Typo="Typo.body2">@context.Permission</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Reason</MudText></MudTd>
                                    <MudTd DataLabel="Window">@($"{context.StartsAt:g} - {context.ExpiresAt:g}")</MudTd>
                                    <MudTd DataLabel="Status">@GetLeaseStatus(context)</MudTd>
                                    <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_isSavingLease" OnClick="@(() => RevokeLeaseAsync(context))">Revoke</MudButton></MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="ORASS">
            <MudGrid>
                <MudItem xs="12" lg="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Profile</MudText>
                        @if (_orassProfile is null) { <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">ORASS profile details are unavailable for this environment.</MudText> }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mt-3">@_orassProfile.InstitutionCode</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_orassProfile.EndpointUrl</MudText>
                            <MudText Typo="Typo.body2" Class="mt-2">@($"Mode {_orassProfile.SubmissionMode} | Cutoff {_orassProfile.CutoffTimeUtc}")</MudText>
                            <MudText Typo="Typo.body2">@($"Source {_orassProfile.SourceReportCode} | Auto submit {(_orassProfile.AutoSubmit ? "Enabled" : "Disabled")}")</MudText>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="8">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Readiness</MudText>
                        @if (_orassReadiness is null) { <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Regulatory readiness data is not available.</MudText> }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@($"Submission mode {_orassReadiness.SubmissionMode} | Source {_orassReadiness.SourceReportCode}")</MudText>
                            <MudText Typo="Typo.body2">@($"Pending {_orassReadiness.PendingReturns} | Ready {_orassReadiness.ReturnsReadyForSubmission}")</MudText>
                            @if (_orassReadiness.MissingRequirements.Length > 0) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@string.Join(" | ", _orassReadiness.MissingRequirements)</MudAlert> }
                            @if (_orassReadiness.Notes.Length > 0) { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@string.Join(" | ", _orassReadiness.Notes)</MudAlert> }
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3" Disabled="@_isActingOnOrass" OnClick="ReconcileAsync">Reconcile Acknowledgements</MudButton>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
            <MudGrid Class="mt-1">
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Submission Queue</MudText>
                        <MudTable T="CoreBanker.Services.OrassQueueItemDto" Items="@_queueItems" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent><MudTh>Return</MudTh><MudTh>Date</MudTh><MudTh>Status</MudTh><MudTh>Records</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Return">@context.ReturnType</MudTd>
                                <MudTd DataLabel="Date">@context.ReturnDate</MudTd>
                                <MudTd DataLabel="Status">@context.SubmissionStatus</MudTd>
                                <MudTd DataLabel="Records">@context.TotalRecords</MudTd>
                                <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@(!context.IsReadyForSubmission || _isActingOnOrass)" OnClick="@(() => SubmitReturnAsync(context.Id))">Submit</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">History & Evidence</MudText>
                        <MudTable T="CoreBanker.Services.OrassSubmissionHistoryItemDto" Items="@_historyItems" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent><MudTh>Return</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Return">@context.ReturnType</MudTd>
                                <MudTd DataLabel="Status">@context.SubmissionStatus</MudTd>
                                <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@_isActingOnOrass" OnClick="@(() => LoadEvidenceAsync(context.Id))">Inspect</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                        @if (_selectedEvidence is not null)
                        {
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2">Selected Evidence</MudText>
                            <MudText Typo="Typo.body2" Class="mt-2">@($"Transmission {_selectedEvidence.TransmissionId}")</MudText>
                            <MudText Typo="Typo.body2">@($"Transport {_selectedEvidence.TransportStatus} | Ack {_selectedEvidence.AcknowledgementStatus}")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_selectedEvidence.EndpointUrl</MudText>
                            <MudTextField @bind-Value="_acknowledgementReference" Label="Acknowledgement Reference" Variant="Variant.Outlined" Class="mt-3" />
                            <MudTextField @bind-Value="_acknowledgementMessage" Label="Acknowledgement Message" Variant="Variant.Outlined" Lines="2" Class="mt-3" />
                            <MudStack Row="true" Spacing="2" Class="mt-3">
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="@_isActingOnOrass" OnClick="@(() => AcknowledgeAsync("RECEIVED"))">Mark Received</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="@_isActingOnOrass" OnClick="@(() => AcknowledgeAsync("ACCEPTED"))">Accept</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@_isActingOnOrass" OnClick="@(() => AcknowledgeAsync("REJECTED"))">Reject</MudButton>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</MudStack>

@code {
    private static readonly string[] UserStatuses = ["ACTIVE", "INACTIVE", "SUSPENDED"];
    private List<CoreBanker.Services.ConfigItemDto> _configItems = new();
    private CoreBanker.Services.ConfigSnapshotDto _snapshot = new();
    private List<CoreBanker.Services.AdminUserDto> _users = new();
    private List<CoreBanker.Services.RoleSummaryDto> _roles = new();
    private List<CoreBanker.Services.BranchDto> _branches = new();
    private List<CoreBanker.Services.PrivilegeLeaseDto> _selectedUserLeases = new();
    private CoreBanker.Services.OrassProfileDto? _orassProfile;
    private CoreBanker.Services.OrassReadinessDto? _orassReadiness;
    private List<CoreBanker.Services.OrassQueueItemDto> _queueItems = new();
    private List<CoreBanker.Services.OrassSubmissionHistoryItemDto> _historyItems = new();
    private CoreBanker.Services.OrassSubmissionEvidenceDto? _selectedEvidence;
    private int? _selectedReturnId;
    private string _acknowledgementReference = string.Empty;
    private string _acknowledgementMessage = string.Empty;
    private string _message = string.Empty;
    private bool _success;
    private bool _isSavingConfig;
    private bool _isSavingUser;
    private bool _isSavingRole;
    private bool _isSavingBranch;
    private bool _isSavingLease;
    private bool _isActingOnOrass;
    private string _userFilter = string.Empty;
    private string? _editingUserId;
    private string? _editingRoleId;
    private string? _editingBranchId;
    private UserFormModel _userForm = new();
    private RoleFormModel _roleForm = new();
    private BranchFormModel _branchForm = new();
    private LeaseFormModel _leaseForm = new();
    private string _rolePermissionsInput = string.Empty;
    private DateTime? _leaseStartDate = DateTime.Today;
    private DateTime? _leaseExpiryDate = DateTime.Today.AddDays(7);

    private IEnumerable<CoreBanker.Services.AdminUserDto> FilteredUsers => _users.Where(user => string.IsNullOrWhiteSpace(_userFilter) || user.Name.Contains(_userFilter, StringComparison.OrdinalIgnoreCase) || user.Email.Contains(_userFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadWorkspaceAsync();

    private async Task LoadWorkspaceAsync()
    {
        _message = string.Empty;
        try
        {
            var configTask = AdminService.GetConfigAsync();
            var usersTask = AdminService.GetUsersAsync();
            var rolesTask = AdminService.GetRolesAsync();
            var branchesTask = AdminService.GetBranchesAsync();
            var profileTask = AdminService.GetOrassProfileAsync();
            var readinessTask = AdminService.GetOrassReadinessAsync();
            var queueTask = AdminService.GetOrassQueueAsync();
            var historyTask = AdminService.GetOrassHistoryAsync();
            await Task.WhenAll(configTask, usersTask, rolesTask, branchesTask, profileTask, readinessTask, queueTask, historyTask);
            _configItems = configTask.Result;
            _users = usersTask.Result.OrderBy(user => user.Name).ToList();
            _roles = rolesTask.Result.OrderBy(role => role.Name).ToList();
            _branches = branchesTask.Result.OrderBy(branch => branch.Code).ToList();
            _orassProfile = profileTask.Result;
            _orassReadiness = readinessTask.Result;
            _queueItems = queueTask.Result;
            _historyItems = historyTask.Result;
            _snapshot = BuildSnapshot(_configItems);
            if (string.IsNullOrWhiteSpace(_leaseForm.StaffId) && _users.Count > 0)
            {
                _leaseForm.StaffId = _users[0].Id;
            }

            await LoadSelectedUserLeasesAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            ShowError(ex.Message);
        }
    }

    private async Task SaveConfigAsync()
    {
        _isSavingConfig = true;
        try
        {
            UpsertConfig("loan.credit_bureau_required_for_approval", _snapshot.LoanCreditBureauRequiredForApproval.ToString().ToLowerInvariant());
            UpsertConfig("eod_scheduler_enabled", _snapshot.EodSchedulerEnabled.ToString().ToLowerInvariant());
            UpsertConfig("eod_scheduler_time_utc", _snapshot.EodSchedulerTimeUtc);
            UpsertConfig("CreditBureau__ActiveProvider", _snapshot.ActiveCreditProvider);
            if (_snapshot.DefaultTransactionLimit.HasValue)
            {
                UpsertConfig("transactions.default_limit", _snapshot.DefaultTransactionLimit.Value.ToString(CultureInfo.InvariantCulture));
            }

            await AdminService.UpdateConfigAsync(_configItems);
            ShowSuccess("Configuration updated successfully.");
            await LoadWorkspaceAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _isSavingConfig = false;
        }
    }

    private async Task SaveUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_userForm.Name) || string.IsNullOrWhiteSpace(_userForm.Email))
        {
            ShowError("Name and email are required.");
            return;
        }

        if (_editingUserId is null && string.IsNullOrWhiteSpace(_userForm.Password))
        {
            ShowError("A password is required when creating a user.");
            return;
        }

        _isSavingUser = true;
        try
        {
            if (_editingUserId is null)
            {
                await AdminService.CreateUserAsync(new CoreBanker.Services.CreateAdminUserRequest
                {
                    Name = _userForm.Name.Trim(),
                    Email = _userForm.Email.Trim(),
                    Phone = NormalizeOptional(_userForm.Phone),
                    RoleId = NormalizeOptional(_userForm.RoleId),
                    BranchId = NormalizeOptional(_userForm.BranchId),
                    Password = _userForm.Password
                });
                ShowSuccess("User created successfully.");
            }
            else
            {
                await AdminService.UpdateUserAsync(_editingUserId, new CoreBanker.Services.UpdateAdminUserRequest
                {
                    Name = _userForm.Name.Trim(),
                    Email = _userForm.Email.Trim(),
                    Phone = NormalizeOptional(_userForm.Phone),
                    RoleId = NormalizeOptional(_userForm.RoleId),
                    BranchId = NormalizeOptional(_userForm.BranchId),
                    Status = NormalizeOptional(_userForm.Status),
                    Password = NormalizeOptional(_userForm.Password)
                });
                ShowSuccess("User updated successfully.");
            }

            ResetUserForm();
            await LoadWorkspaceAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _isSavingUser = false;
        }
    }

