@page "/security"
@layout CoreBanker.Layouts.MainLayout

@inject CoreBanker.Services.SecurityService SecurityService
@inject NavigationManager Navigation

<MudStack Spacing="3">
    <MudPaper Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">Security Overview</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Quick operational summary of alerts, device posture, and active user sessions.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/security-ops"))">Open Security Ops</MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><MudCard><MudCardContent><MudText Typo="Typo.subtitle2">Alerts</MudText><MudText Typo="Typo.h5">@(_summary?.SecurityAlertCount ?? 0)</MudText></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard><MudCardContent><MudText Typo="Typo.subtitle2">Active Sessions</MudText><MudText Typo="Typo.h5">@(_summary?.ActiveSessions ?? 0)</MudText></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard><MudCardContent><MudText Typo="Typo.subtitle2">Outdated Devices</MudText><MudText Typo="Typo.h5">@(_summary?.OutdatedDevices ?? 0)</MudText></MudCardContent></MudCard></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudCard><MudCardContent><MudText Typo="Typo.subtitle2">Irregular Activity</MudText><MudText Typo="Typo.h5">@(_summary?.IrregularActivityCount ?? 0)</MudText></MudCardContent></MudCard></MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Recent Alerts</MudText>
                <MudTable T="CoreBanker.Services.SecurityAlertDto" Items="@_alerts" Dense="true" Hover="true" Loading="@_isLoading" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Action</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Date</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Action">@context.Action</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="Date">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Flagged Devices</MudText>
                <MudTable T="CoreBanker.Services.SecurityDeviceDto" Items="@FlaggedDevices" Dense="true" Hover="true" Loading="@_isLoading" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Risk</MudTh>
                        <MudTh>Software</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Risk">@context.RiskLevel</MudTd>
                        <MudTd DataLabel="Software">@context.SoftwareStatus</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private CoreBanker.Services.SecuritySummaryDto? _summary;
    private List<CoreBanker.Services.SecurityAlertDto> _alerts = new();
    private List<CoreBanker.Services.SecurityDeviceDto> _devices = new();
    private bool _isLoading;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var summaryTask = SecurityService.GetSummaryAsync();
            var alertsTask = SecurityService.GetAlertsAsync(10);
            var devicesTask = SecurityService.GetDevicesAsync();
            await Task.WhenAll(summaryTask, alertsTask, devicesTask);
            _summary = summaryTask.Result;
            _alerts = alertsTask.Result;
            _devices = devicesTask.Result;
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<CoreBanker.Services.SecurityDeviceDto> FlaggedDevices =>
        _devices.Where(device => device.RequiresReview || device.SoftwareStatus == "OUTDATED" || device.RiskLevel == "HIGH")
            .OrderByDescending(device => device.RiskLevel)
            .Take(8);
}
