@page "/approvals"
@layout CoreBanker.Layouts.MainLayout

@inject CoreBanker.Services.ApprovalService ApprovalService

<MudGrid>
    <MudItem xs="12" lg="7">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.h4">Approval Inbox</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Review workflow items and action pending requests directly from the banking workspace.</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadApprovalsAsync">Refresh</MudButton>
                </MudStack>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 corebanker-friendly-stat" Elevation="0">
                        <MudText Typo="Typo.caption">Pending</MudText>
                        <MudText Typo="Typo.h5">@_approvalItems.Count(item => string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Items needing a decision.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 corebanker-friendly-stat" Elevation="0">
                        <MudText Typo="Typo.caption">Approved</MudText>
                        <MudText Typo="Typo.h5">@_approvalItems.Count(item => string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase))</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Completed checker decisions.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 corebanker-friendly-stat" Elevation="0">
                        <MudText Typo="Typo.caption">Over 24h</MudText>
                        <MudText Typo="Typo.h5">@_approvalItems.Count(item => GetApprovalAgeHours(item) > 24 && string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Aged items needing escalation.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="7">
                        <MudTextField @bind-Value="_searchTerm" Label="Search by type, reference, requester, or entity" Variant="Variant.Outlined" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudSelect @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined">
                            <MudSelectItem Value="@string.Empty">All</MudSelectItem>
                            <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                            <MudSelectItem Value="@("Approved")">Approved</MudSelectItem>
                            <MudSelectItem Value="@("Rejected")">Rejected</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
            }

            @if (!_isLoading && !FilteredApprovals.Any())
            {
                <MudPaper Class="pa-6 corebanker-empty-state" Elevation="0">
                    <MudText Typo="Typo.h6">No approvals match this view</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Clear the current search or status filter to bring more workflow items back into view.</MudText>
                </MudPaper>
            }
            else
            {
                <MudTable Items="@FilteredApprovals" Hover="true" Dense="true" Loading="@_isLoading">
                    <HeaderContent>
                        <MudTh>Type</MudTh>
                        <MudTh>Reference</MudTh>
                        <MudTh>Requester</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Age</MudTh>
                        <MudTh>Created</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Type">@context.Type</MudTd>
                        <MudTd DataLabel="Reference">
                            <MudText Typo="Typo.body2">@context.Reference</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.EntityId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Requester">@DisplayValue(context.RequestedBy)</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Age">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetAgingColor(context)">@GetApprovalAgeLabel(context)</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectApproval(context))">Inspect</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5">Approval Workspace</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Loan details, remarks, and decision controls for the selected workflow item.</MudText>
            </MudPaper>

            @if (_selectedApproval is null)
            {
                <MudPaper Class="pa-6 corebanker-empty-state" Elevation="0">
                    <MudText Typo="Typo.h6">Select an approval to start review</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">The right pane will show workflow context, loan details, and decision controls.</MudText>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">@_selectedApproval.Type</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_selectedApproval.Reference</MudText>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2">Workflow: @DisplayValue(_selectedApproval.WorkflowName)</MudText>
                    <MudText Typo="Typo.body2">Requester: @DisplayValue(_selectedApproval.RequestedBy)</MudText>
                    <MudText Typo="Typo.body2">Status: @_selectedApproval.Status</MudText>
                    <MudText Typo="Typo.body2">Age: @GetApprovalAgeLabel(_selectedApproval)</MudText>
                    <MudText Typo="Typo.body2">Created: @_selectedApproval.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</MudText>
                    <MudText Typo="Typo.body2">Step: @_selectedApproval.CurrentStep</MudText>
                    <MudText Typo="Typo.body2">Remarks: @DisplayValue(_selectedApproval.Remarks)</MudText>
                </MudPaper>

                @if (_selectedApproval.LoanDetails is not null)
                {
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.subtitle1">Loan Context</MudText>
                        <MudText Typo="Typo.body2">Customer: @DisplayValue(_selectedApproval.LoanDetails.CustomerName) (@_selectedApproval.LoanDetails.CustomerId)</MudText>
                        <MudText Typo="Typo.body2">Product: @DisplayValue(_selectedApproval.LoanDetails.ProductName)</MudText>
                        <MudText Typo="Typo.body2">Principal: @FormatAmount(_selectedApproval.LoanDetails.Principal)</MudText>
                        <MudText Typo="Typo.body2">Outstanding: @FormatAmount(_selectedApproval.LoanDetails.OutstandingBalance)</MudText>
                        <MudText Typo="Typo.body2">Rate / Term: @_selectedApproval.LoanDetails.Rate% / @_selectedApproval.LoanDetails.TermMonths months</MudText>
                        <MudText Typo="Typo.body2">Collateral: @DisplayValue(_selectedApproval.LoanDetails.CollateralType) @(_selectedApproval.LoanDetails.CollateralValue > 0 ? $"({FormatAmount(_selectedApproval.LoanDetails.CollateralValue)})" : string.Empty)</MudText>
                        <MudText Typo="Typo.body2">Portfolio Bucket: @DisplayValue(_selectedApproval.LoanDetails.ParBucket)</MudText>
                    </MudPaper>
                }

                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle1">Decision</MudText>
                    <MudTextField @bind-Value="_decisionRemarks" Label="Decision remarks" Variant="Variant.Outlined" Lines="3" />
                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(_isSubmitting || _selectedApproval.Status != "Pending")" OnClick="@(() => UpdateApprovalAsync("APPROVED"))">Approve</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(_isSubmitting || _selectedApproval.Status != "Pending")" OnClick="@(() => UpdateApprovalAsync("REJECTED"))">Reject</MudButton>
                    </MudStack>
                </MudPaper>

                @if (ApprovalPayloadPreview.Any())
                {
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.subtitle1">Request Change Preview</MudText>
                        <MudGrid Class="mt-2">
                            @foreach (var item in ApprovalPayloadPreview)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.caption">@item.Key</MudText>
                                        <MudText Typo="Typo.body2">@item.Value</MudText>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudPaper>
                }

                @if (!string.IsNullOrWhiteSpace(_workspaceMessage))
                {
                    <MudAlert Severity="@(_workspaceSuccess ? Severity.Success : Severity.Error)">@_workspaceMessage</MudAlert>
                }
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private List<CoreBanker.Services.ApprovalDto> _approvalItems = new();
    private CoreBanker.Services.ApprovalDto? _selectedApproval;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _decisionRemarks = string.Empty;
    private string _loadError = string.Empty;
    private string _workspaceMessage = string.Empty;
    private bool _workspaceSuccess;
    private bool _isLoading;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovalsAsync();
    }

    private async Task LoadApprovalsAsync()
    {
        _isLoading = true;
        _loadError = string.Empty;

        try
        {
            _approvalItems = await ApprovalService.GetApprovalsAsync();
            if (_selectedApproval is not null)
            {
                _selectedApproval = _approvalItems.FirstOrDefault(item => item.Id == _selectedApproval.Id);
            }
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectApproval(CoreBanker.Services.ApprovalDto approval)
    {
        _selectedApproval = approval;
        _decisionRemarks = approval.Remarks;
        _workspaceMessage = string.Empty;
    }

    private async Task UpdateApprovalAsync(string status)
    {
        if (_selectedApproval is null)
        {
            return;
        }

        _isSubmitting = true;
        _workspaceMessage = string.Empty;

        try
        {
            var updated = await ApprovalService.UpdateApprovalAsync(_selectedApproval.Id, new CoreBanker.Services.UpdateApprovalRequest
            {
                Status = status,
                CurrentStep = status == "APPROVED" ? 1 : 0,
                Remarks = _decisionRemarks
            });

            _workspaceSuccess = true;
            _workspaceMessage = updated is null ? "Approval updated." : $"Approval marked as {updated.Status}.";
            await LoadApprovalsAsync();
            if (updated is not null)
            {
                _selectedApproval = _approvalItems.FirstOrDefault(item => item.Id == updated.Id);
            }
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _workspaceSuccess = false;
            _workspaceMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private IEnumerable<CoreBanker.Services.ApprovalDto> FilteredApprovals =>
        _approvalItems.Where(approval =>
            (string.IsNullOrWhiteSpace(_searchTerm)
             || approval.Type.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
             || approval.Reference.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
             || approval.RequestedBy.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
             || approval.EntityId.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(_statusFilter) || approval.Status == _statusFilter));

    private IReadOnlyList<KeyValuePair<string, string>> ApprovalPayloadPreview =>
        ParsePayloadPreview(_selectedApproval?.PayloadJson);

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }

    private static string FormatAmount(decimal amount)
    {
        return CoreBanker.Utilities.CurrencyFormatter.Format(amount);
    }

    private static Color GetStatusColor(string? status)
    {
        return string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase)
            ? Color.Warning
            : string.Equals(status, "Approved", StringComparison.OrdinalIgnoreCase)
                ? Color.Success
                : Color.Error;
    }

    private static double GetApprovalAgeHours(CoreBanker.Services.ApprovalDto approval)
        => Math.Max(0, (DateTime.UtcNow - approval.CreatedAt).TotalHours);

    private static string GetApprovalAgeLabel(CoreBanker.Services.ApprovalDto approval)
        => $"{GetApprovalAgeHours(approval):N1}h";

    private static Color GetAgingColor(CoreBanker.Services.ApprovalDto approval)
        => GetApprovalAgeHours(approval) > 72
            ? Color.Error
            : GetApprovalAgeHours(approval) > 24
                ? Color.Warning
                : Color.Success;

    private static IReadOnlyList<KeyValuePair<string, string>> ParsePayloadPreview(string? payloadJson)
    {
        if (string.IsNullOrWhiteSpace(payloadJson))
        {
            return Array.Empty<KeyValuePair<string, string>>();
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(payloadJson);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                return Array.Empty<KeyValuePair<string, string>>();
            }

            return document.RootElement
                .EnumerateObject()
                .Take(6)
                .Select(property => new KeyValuePair<string, string>(
                    property.Name,
                    property.Value.ValueKind switch
                    {
                        System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array => property.Value.GetRawText(),
                        _ => property.Value.ToString()
                    }))
                .ToList();
        }
        catch
        {
            return Array.Empty<KeyValuePair<string, string>>();
        }
    }
}
