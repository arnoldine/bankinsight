@page "/fintech-platform"
@layout CoreBanker.Layouts.MainLayout
@using CoreBanker.Services

@inject CoreBanker.Services.FintechWorkspaceService FintechWorkspaceService
@inject NavigationManager Navigation

<MudStack Spacing="3">
    <MudPaper Class="pa-5 corebanker-command-deck corebanker-workspace-header" Elevation="0">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" lg="8">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <div class="corebanker-page-icon corebanker-icon-violet">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.overline" Class="corebanker-eyebrow">Integrated Module</MudText>
                        <MudText Typo="Typo.h3" Class="mt-1">Fintech Platform</MudText>
                        <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">
                            Operate the Ghana-focused hybrid transfer platform from CoreBanker with the same shared BankInsight fintech backend, multi-currency wallet model, and blockchain-first cross-border posture.
                        </MudText>
                    </div>
                </MudStack>
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudGrid>
                    <MudItem xs="6">
                        <MudPaper Class="pa-3 corebanker-mini-stat" Elevation="0">
                            <MudText Typo="Typo.caption">API Health</MudText>
                            <MudText Typo="Typo.subtitle1">@(_snapshot?.Health.Status ?? "Checking")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Class="pa-3 corebanker-mini-stat" Elevation="0">
                            <MudText Typo="Typo.caption">Checked</MudText>
                            <MudText Typo="Typo.subtitle1">@((_snapshot?.Health.CheckedAtUtc.ToLocalTime().ToString("dd MMM HH:mm")) ?? "Pending")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadWorkspaceAsync">
                            Refresh Workspace
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="6" xl="3">
            <MudPaper Class="pa-4 corebanker-metric-card" Elevation="0">
                <MudText Typo="Typo.caption">Operating Model</MudText>
                <MudText Typo="Typo.h6">Custodial + Multi-Currency</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Internal ledgered wallets with crypto deposit, fiat conversion, and supported multi-currency balances.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" xl="3">
            <MudPaper Class="pa-4 corebanker-metric-card" Elevation="0">
                <MudText Typo="Typo.caption">Outbound Rails</MudText>
                <MudText Typo="Typo.h6">Domestic + Blockchain</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Domestic bank and mobile money rails stay local, while cross-border value moves over governed blockchain withdrawals.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" xl="3">
            <MudPaper Class="pa-4 corebanker-metric-card" Elevation="0">
                <MudText Typo="Typo.caption">Compliance</MudText>
                <MudText Typo="Typo.h6">Maker-Checker</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">KYC, AML alerts, approval queues, audit trails, and callback replay controls.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" xl="3">
            <MudPaper Class="pa-4 corebanker-metric-card" Elevation="0">
                <MudText Typo="Typo.caption">Settlement Control</MudText>
                <MudText Typo="Typo.h6">Reconciled</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Provider status sync, divergence breaks, and pending-to-settlement ledger posting.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" xl="6">
            <MudPaper Class="pa-4" Elevation="0">
                <MudStack Class="corebanker-section-heading" Spacing="0">
                    <MudText Typo="Typo.h6">Launch Points</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Open the shared fintech surfaces from CoreBanker without losing workspace context.</MudText>
                </MudStack>

                <MudStack Spacing="2" Class="mt-3">
                    <MudPaper Class="pa-3 corebanker-watchlist-item" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.subtitle2">BankInsight Fintech Workspace</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Open the React operations hub with transfers, compliance, treasury, and reconciliation tabs.</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenExternal(_snapshot?.BankInsightWorkspaceUrl))">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                    <MudPaper Class="pa-3 corebanker-watchlist-item" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.subtitle2">Fintech Admin Portal</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Launch the Blazor admin shell for deeper compliance, ledger, and reconciliation operations.</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenExternal(_snapshot?.FintechAdminUrl))">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                    <MudPaper Class="pa-3 corebanker-watchlist-item" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.subtitle2">Fintech Swagger</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Inspect the shared `/api/v1` contract for wallets, transfers, risk, reports, and webhooks.</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenExternal(_snapshot?.SwaggerUrl))">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" xl="6">
            <MudPaper Class="pa-4" Elevation="0">
                <MudStack Class="corebanker-section-heading" Spacing="0">
                    <MudText Typo="Typo.h6">Supported Flows</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">CoreBanker now reflects the fintech operating perimeter exposed through the shared host.</MudText>
                </MudStack>

                <MudStack Spacing="2" Class="mt-3">
                    @foreach (var item in _snapshot?.SupportedFlows ?? [])
                    {
                        <MudPaper Class="pa-3 corebanker-flow-card" Elevation="0">
                            <MudText Typo="Typo.subtitle2">@item</MudText>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4" Elevation="0">
        <MudStack Class="corebanker-section-heading" Spacing="0">
            <MudText Typo="Typo.h6">Governance Controls</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">The same production-grade controls wired into BankInsight are now visible from CoreBanker too.</MudText>
        </MudStack>

        <MudGrid Class="mt-3">
            @foreach (var item in _snapshot?.GovernanceControls ?? [])
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4 corebanker-friendly-guide" Elevation="0">
                        <MudText Typo="Typo.subtitle2">@item</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
</MudStack>

@code {
    private FintechWorkspaceSnapshot? _snapshot;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        _error = null;

        try
        {
            _snapshot = await FintechWorkspaceService.GetWorkspaceSnapshotAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenExternal(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri))
        {
            return;
        }

        Navigation.NavigateTo(uri, forceLoad: true);
    }
}
