@page "/login"
@layout CoreBanker.Layouts.LoginLayout
@inject CoreBanker.Auth.AuthService AuthService
@inject CoreBanker.State.AppState AppState
@inject NavigationManager Navigation

<MudPaper Class="login-card pa-6" Elevation="8">
    <div class="login-card-header">
        <div class="login-card-badge">Secure Access</div>
        <MudText Typo="Typo.overline" Class="login-eyebrow">CoreBanker</MudText>
        <MudText Typo="Typo.h4" Class="mb-2">Sign in to your banking workspace</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">Use your BankInsight operator credentials to open the live operational console.</MudText>
        <div class="login-trust-row">
            <span class="login-trust-pill">MFA enforced</span>
            <span class="login-trust-pill">Permission-aware workspace</span>
            <span class="login-trust-pill">Audited access</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AppState.WorkspaceMessage))
    {
        <MudAlert Severity="@AppState.WorkspaceMessageSeverity" Dense="true" Class="mb-4">
            @AppState.WorkspaceMessage
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@statusMessage</MudAlert>
    }

    @if (!mfaRequired)
    {
        <MudForm @ref="form" OnValidSubmit="HandleLogin">
            <MudTextField @bind-Value="Email"
                          Label="Work Email"
                          Placeholder="name@bankinsight.local"
                          Required="true"
                          For="@(() => Email)"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          HelperText="Use your provisioned operator identity."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.AlternateEmail" />
            <MudTextField @bind-Value="Password"
                          Label="Password"
                          InputType="InputType.Password"
                          Required="true"
                          For="@(() => Password)"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mt-3"
                          HelperText="Passwords are never stored in the browser."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock" />
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4 login-primary-action" Disabled="@loading" FullWidth="true">
                @(loading ? "Signing In..." : "Login")
            </MudButton>
        </MudForm>
        <MudProgressLinear Indeterminate="true" Visible="@loading" Class="mt-3" />
        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@error</MudAlert>
        }

        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-4">
            Only authorized banking staff should sign in here. Contact your system administrator if access has not been provisioned.
        </MudAlert>
        <MudText Typo="Typo.caption" Class="login-help-copy mt-4">Use the local admin credentials or your provisioned BankInsight operator account to continue.</MudText>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
            Enter the 6-digit code sent to @deliveryHint.
            @if (!string.IsNullOrWhiteSpace(debugCode))
            {
                <span> Debug code: <strong>@debugCode</strong></span>
            }
        </MudAlert>

        <MudForm @ref="mfaForm" OnValidSubmit="HandleMfa">
            <MudTextField @bind-Value="MfaCode"
                          Label="MFA Code"
                          Placeholder="Enter 6-digit code"
                          Required="true"
                          For="@(() => MfaCode)"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          HelperText="Codes expire quickly for security."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Shield" />
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4 login-primary-action" Disabled="@mfaLoading" FullWidth="true">
                @(mfaLoading ? "Verifying..." : "Verify")
            </MudButton>
        </MudForm>
        <MudProgressLinear Indeterminate="true" Visible="@mfaLoading" Class="mt-3" />
        @if (!string.IsNullOrEmpty(mfaError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@mfaError</MudAlert>
        }
        <div class="login-secondary-actions">
            <MudButton Variant="Variant.Text" OnClick="ResendMfa" Disabled="@mfaLoading" Class="mt-2">Resend Code</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="RestartLogin" Disabled="@mfaLoading" Class="mt-2">Use different account</MudButton>
        </div>
    }

    <div class="login-footer-note">
        <MudText Typo="Typo.caption">This workspace records access activity for operational governance and audit review.</MudText>
    </div>
</MudPaper>

@code {
    private MudForm? form;
    private MudForm? mfaForm;
    private string Email = string.Empty;
    private string Password = string.Empty;
    private bool loading;
    private string? error;
    private bool mfaRequired;
    private string MfaCode = string.Empty;
    private bool mfaLoading;
    private string? mfaError;
    private string? mfaToken;
    private string? deliveryHint;
    private string? statusMessage;
    private string? debugCode;

    protected override void OnInitialized()
    {
        if (AppState.IsAuthenticated)
        {
            Navigation.NavigateTo(AppState.GetDefaultRoute(), true);
        }
    }

    private async Task HandleLogin()
    {
        if (form is not null)
        {
            await form.ValidateAsync();
            if (!form.IsValid)
            {
                return;
            }
        }

        loading = true;
        error = null;
        statusMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(Email, Password);
            if (result.RequiresMfa)
            {
                mfaRequired = true;
                mfaToken = result.MfaToken;
                deliveryHint = result.DeliveryHint ?? result.DeliveryChannel ?? "your registered factor";
                statusMessage = result.DeliveryMessage;
                debugCode = result.DebugCode;
                MfaCode = string.Empty;
                return;
            }

            Navigation.NavigateTo(AppState.GetDefaultRoute(), true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleMfa()
    {
        if (mfaForm is not null)
        {
            await mfaForm.ValidateAsync();
            if (!mfaForm.IsValid)
            {
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(mfaToken))
        {
            mfaError = "Your verification session has expired. Please sign in again.";
            mfaRequired = false;
            return;
        }

        mfaLoading = true;
        mfaError = null;

        try
        {
            var result = await AuthService.VerifyMfaAsync(mfaToken, MfaCode);
            if (!result)
            {
                mfaError = "The verification code was not accepted.";
                return;
            }

            Navigation.NavigateTo(AppState.GetDefaultRoute(), true);
        }
        catch (Exception ex)
        {
            mfaError = ex.Message;
        }
        finally
        {
            mfaLoading = false;
        }
    }

    private async Task ResendMfa()
    {
        if (string.IsNullOrWhiteSpace(mfaToken))
        {
            mfaError = "Your verification session has expired. Please sign in again.";
            return;
        }

        mfaLoading = true;
        mfaError = null;
        statusMessage = null;

        try
        {
            var result = await AuthService.ResendMfaAsync(mfaToken);
            mfaToken = result.MfaToken ?? mfaToken;
            deliveryHint = result.DeliveryHint ?? deliveryHint;
            statusMessage = result.DeliveryMessage ?? "A fresh verification code has been sent.";
            debugCode = result.DebugCode;
        }
        catch (Exception ex)
        {
            mfaError = ex.Message;
        }
        finally
        {
            mfaLoading = false;
        }
    }

    private void RestartLogin()
    {
        mfaRequired = false;
        mfaToken = null;
        deliveryHint = null;
        debugCode = null;
        MfaCode = string.Empty;
        statusMessage = null;
        mfaError = null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !AppState.IsAuthenticated)
        {
            AppState.ClearWorkspaceMessage();
        }
    }
}
