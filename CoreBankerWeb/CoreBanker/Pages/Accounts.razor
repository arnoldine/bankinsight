@page "/accounts"
@layout CoreBanker.Layouts.MainLayout

@inject CoreBanker.Services.AccountService AccountService
@inject CoreBanker.Services.ClientService ClientService

<MudGrid>
    <MudItem xs="12" xl="7">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">Deposit Accounts</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Open customer accounts and review balances, product codes, and branch portfolio activity.</MudText>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 corebanker-friendly-stat" Elevation="0">
                        <MudText Typo="Typo.caption">Matched Accounts</MudText>
                        <MudText Typo="Typo.h5">@_accountTotalCount</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@($"{_accounts.Count} loaded on this page")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 corebanker-friendly-stat" Elevation="0">
                        <MudText Typo="Typo.caption">Portfolio Value</MudText>
                        <MudText Typo="Typo.h5">@FormatAmount(_accounts.Sum(account => account.AvailableBalance), "GHS")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Available balances across the loaded page.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 corebanker-friendly-stat" Elevation="0">
                        <MudText Typo="Typo.caption">Selected Customer</MudText>
                        <MudText Typo="Typo.h5">@GetCustomerName(_request.CustomerId)</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@($"{_selectedCustomerAccounts.Count} linked account(s)")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudTextField Value="@_searchTerm" ValueChanged="@(async (string value) => await OnAccountSearchChanged(value))" Label="Search by account, customer, branch, or product" Variant="Variant.Outlined" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect Value="@_typeFilter" ValueChanged="@(async (string value) => await OnTypeFilterChanged(value))" Label="Account type" Variant="Variant.Outlined">
                            <MudSelectItem Value="@string.Empty">All</MudSelectItem>
                            <MudSelectItem Value="@("SAVINGS")">Savings</MudSelectItem>
                            <MudSelectItem Value="@("CURRENT")">Current</MudSelectItem>
                            <MudSelectItem Value="@("FIXED_DEPOSIT")">Fixed Deposit</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
            }

            @if (!_isLoadingAccounts && _accountTotalCount == 0)
            {
                <MudPaper Class="pa-6 corebanker-empty-state" Elevation="0">
                    <MudText Typo="Typo.h6">No accounts match this filter</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Search by customer name, account number, branch, or product to refine the list.</MudText>
                </MudPaper>
            }
            else
            {
                <MudTable T="CoreBanker.Services.AccountListItemDto" @ref="_accountsTable" ServerData="LoadAccountsTableData" Hover="true" Dense="true" Loading="@_isLoadingAccounts" RowsPerPage="25">
                    <HeaderContent>
                        <MudTh>Account</MudTh>
                        <MudTh>Customer</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Product</MudTh>
                        <MudTh>Available</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Account">
                            <MudText Typo="Typo.body2">@context.Id</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.BranchId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Customer">
                            <MudText Typo="Typo.body2">@context.CustomerName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CustomerId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Type">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@context.Type</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Product">@context.ProductCode</MudTd>
                        <MudTd DataLabel="Available">@FormatAmount(context.AvailableBalance, context.Currency)</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(string.Equals(context.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Default)">@context.Status</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudItem>

    <MudItem xs="12" xl="5">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5">Open New Account</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Create a live account against an existing customer record.</MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Choose the customer first and the portfolio panel below will show any existing linked accounts before you create another one.
                </MudAlert>

                @if (_selectedCustomerProfile?.KycReadiness is not null)
                {
                    <MudAlert Severity="@(_selectedCustomerProfile.KycReadiness.IsReadyForAccountOpening ? Severity.Success : Severity.Warning)" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                        @if (_selectedCustomerProfile.KycReadiness.IsReadyForAccountOpening)
                        {
                            <span>Customer KYC is verified for account opening.</span>
                        }
                        else
                        {
                            <span>Account opening is blocked until these are verified: @string.Join(", ", _selectedCustomerProfile.KycReadiness.MissingRequirements)</span>
                        }
                    </MudAlert>
                }

                <MudForm @ref="_form" OnValidSubmit="CreateAccountAsync" Class="mt-4">
                    <MudAutocomplete T="CoreBanker.Services.ClientDto"
                                     Label="Customer"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     Value="@_selectedClient"
                                     ValueChanged="OnSelectedClientChanged"
                                     SearchFunc="SearchClientsAsync"
                                     ToStringFunc="@(client => client is null ? string.Empty : $"{client.Name} ({client.Id})")"
                                     ResetValueOnEmptyText="false"
                                     CoerceText="false"
                                     Dense="true" />
                    <MudTextField @bind-Value="_request.BranchId" Label="Branch ID" Variant="Variant.Outlined" Class="mt-3" />
                    <MudSelect @bind-Value="_request.Type" Label="Account type" Required="true" Variant="Variant.Outlined" Class="mt-3">
                        <MudSelectItem Value="@("SAVINGS")">Savings</MudSelectItem>
                        <MudSelectItem Value="@("CURRENT")">Current</MudSelectItem>
                        <MudSelectItem Value="@("FIXED_DEPOSIT")">Fixed Deposit</MudSelectItem>
                    </MudSelect>
                    <MudSelect @bind-Value="_request.Currency" Label="Currency" Required="true" Variant="Variant.Outlined" Class="mt-3">
                        <MudSelectItem Value="@("GHS")">GHS</MudSelectItem>
                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="_request.ProductCode" Label="Product code" Variant="Variant.Outlined" Class="mt-3" HelperText="Defaults to SAV001, CUR001, or FD001 if left blank." />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="@(_isCreating || !CanCreateAccount)">Create account</MudButton>
                </MudForm>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <MudAlert Severity="@(_isSuccess ? Severity.Success : Severity.Error)">@_message</MudAlert>
            }

            @if (_selectedCustomerAccounts.Count > 0)
            {
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle1">Selected Customer Portfolio</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetCustomerName(_request.CustomerId)</MudText>

                    <MudTable Items="@_selectedCustomerAccounts" Dense="true" Hover="true" Class="mt-3">
                        <HeaderContent>
                            <MudTh>Account</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Available</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Account">@context.Id</MudTd>
                            <MudTd DataLabel="Type">@context.Type</MudTd>
                            <MudTd DataLabel="Available">@FormatAmount(context.AvailableBalance, context.Currency)</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private List<CoreBanker.Services.AccountListItemDto> _accounts = new();
    private MudTable<CoreBanker.Services.AccountListItemDto>? _accountsTable;
    private List<CoreBanker.Services.AccountDto> _selectedCustomerAccounts = new();
    private CoreBanker.Services.ClientProfileDto? _selectedCustomerProfile;
    private CoreBanker.Services.ClientDto? _selectedClient;
    private CoreBanker.Services.CreateAccountRequest _request = new()
    {
        BranchId = "BR001",
        Type = "SAVINGS",
        Currency = "GHS"
    };
    private MudForm? _form;
    private string _searchTerm = string.Empty;
    private string _typeFilter = string.Empty;
    private string _loadError = string.Empty;
    private string _message = string.Empty;
    private bool _isSuccess;
    private bool _isCreating;
    private bool _isLoadingAccounts;
    private int _accountTotalCount;
    private bool CanCreateAccount => _selectedCustomerProfile?.KycReadiness?.IsReadyForAccountOpening ?? false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        var firstPage = await AccountService.GetAccountPageAsync(1, 25);
        _accounts = firstPage.Items;
        _accountTotalCount = firstPage.TotalCount;
        await RefreshSelectedCustomerAccountsAsync();
    }

    private async Task<TableData<CoreBanker.Services.AccountListItemDto>> LoadAccountsTableData(TableState state, CancellationToken cancellationToken)
    {
        _isLoadingAccounts = true;
        _loadError = string.Empty;

        try
        {
            var page = await AccountService.GetAccountPageAsync(state.Page + 1, state.PageSize, _searchTerm, _typeFilter, cancellationToken);
            _accounts = page.Items;
            _accountTotalCount = page.TotalCount;

            return new TableData<CoreBanker.Services.AccountListItemDto>
            {
                Items = _accounts,
                TotalItems = _accountTotalCount
            };
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _loadError = ex.Message;
            return new TableData<CoreBanker.Services.AccountListItemDto>
            {
                Items = Array.Empty<CoreBanker.Services.AccountListItemDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            _isLoadingAccounts = false;
        }
    }

    private async Task OnAccountSearchChanged(string value)
    {
        _searchTerm = value;
        if (_accountsTable is not null)
        {
            await _accountsTable.ReloadServerData();
        }
    }

    private async Task OnTypeFilterChanged(string value)
    {
        _typeFilter = value;
        if (_accountsTable is not null)
        {
            await _accountsTable.ReloadServerData();
        }
    }

    private async Task CreateAccountAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isCreating = true;
        _message = string.Empty;

        try
        {
            var created = await AccountService.CreateAccountAsync(_request);
            _isSuccess = true;
            _message = created is null
                ? "Account created successfully."
                : $"Account {created.Id} created successfully.";

            _request = new CoreBanker.Services.CreateAccountRequest
            {
                CustomerId = _request.CustomerId,
                BranchId = "BR001",
                Type = "SAVINGS",
                Currency = "GHS"
            };

            _selectedClient = null;
            if (_accountsTable is not null)
            {
                await _accountsTable.ReloadServerData();
            }
            await RefreshSelectedCustomerAccountsAsync();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _isSuccess = false;
            _message = ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task RefreshSelectedCustomerAccountsAsync()
    {
        if (string.IsNullOrWhiteSpace(_request.CustomerId))
        {
            _selectedCustomerAccounts.Clear();
            _selectedCustomerProfile = null;
            return;
        }

        _selectedCustomerAccounts = await AccountService.GetAccountsByCustomerIdAsync(_request.CustomerId);
        _selectedCustomerProfile = await ClientService.GetClientProfileAsync(_request.CustomerId);
    }

    private string GetCustomerName(string customerId)
    {
        return string.Equals(_selectedClient?.Id, customerId, StringComparison.OrdinalIgnoreCase)
            ? (_selectedClient?.Name ?? customerId)
            : _selectedCustomerProfile?.Name ?? customerId;
    }

    private async Task<IEnumerable<CoreBanker.Services.ClientDto>> SearchClientsAsync(string value, CancellationToken cancellationToken)
    {
        return await ClientService.SearchClientsAsync(value, 20, cancellationToken);
    }

    private async Task OnSelectedClientChanged(CoreBanker.Services.ClientDto? client)
    {
        _selectedClient = client;
        _request.CustomerId = client?.Id ?? string.Empty;
        await RefreshSelectedCustomerAccountsAsync();
    }

    private static string FormatAmount(decimal amount, string currency)
    {
        return CoreBanker.Utilities.CurrencyFormatter.Format(amount, currency);
    }
}
