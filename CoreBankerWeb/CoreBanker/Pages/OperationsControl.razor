@page "/operations-control"
@inject CoreBanker.Services.PlatformEnhancementService PlatformService
@inject NavigationManager Navigation

<PageTitle>Operations Control</PageTitle>

<MudStack Spacing="3">
    <MudPaper Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.overline">Operations Control Center</MudText>
                <MudText Typo="Typo.h5">Enterprise operations command view</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Monitor queues, controls, and operational exceptions from one governed workspace.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Refresh</MudButton>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_summary is not null)
    {
        <MudGrid>
            @foreach (var metric in _summary.Metrics)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">@metric.Label</MudText>
                        <MudText Typo="Typo.h5">@metric.Value</MudText>
                        @if (!string.IsNullOrWhiteSpace(metric.Subtitle))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@metric.Subtitle</MudText>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Actionable Work Items</MudText>
            <MudTable Items="_summary.WorkItems" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Category</MudTh>
                    <MudTh>Severity</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Detail</MudTh>
                    <MudTh>Count</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Category</MudTd>
                    <MudTd>@context.Severity</MudTd>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@context.Detail</MudTd>
                    <MudTd>@(context.Count?.ToString() ?? "-")</MudTd>
                    <MudTd>
                        @if (!string.IsNullOrWhiteSpace(context.RouteHint))
                        {
                            <MudButton Variant="Variant.Text" OnClick="@(() => OpenRoute(context.RouteHint!))">Open</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private CoreBanker.Services.OperationsControlCenterVm? _summary;
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _summary = await PlatformService.GetOperationsControlSummaryAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenRoute(string routeHint)
    {
        Navigation.NavigateTo(routeHint);
    }
}
