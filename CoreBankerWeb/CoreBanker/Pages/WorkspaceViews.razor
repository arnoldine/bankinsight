@page "/workspaces"
@layout CoreBanker.Layouts.MainLayout

@inject CoreBanker.Services.LoanService LoanService
@inject CoreBanker.Services.ApprovalService ApprovalService
@inject CoreBanker.Services.AccountingService AccountingService
@inject CoreBanker.Services.ClientService ClientService
@inject CoreBanker.Services.AccountService AccountService
@inject CoreBanker.Services.AuditService AuditService
@inject NavigationManager Navigation

<MudStack Spacing="3">
    <MudPaper Class="pa-4 corebanker-command-deck" Elevation="0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
            <div>
                <MudText Typo="Typo.overline" Class="corebanker-eyebrow">Role Command Center</MudText>
                <MudText Typo="Typo.h4">Workspace Views</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Role-oriented dashboards built from the same live data powering the operational modules.</MudText>
            </div>
            <MudStack Row="true" Spacing="1" Class="mt-2 mt-md-0">
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@_workspaceCards.Count view(s)</MudChip>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadWorkspaceAsync">Refresh</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="Severity.Error">@_message</MudAlert>
    }

    <MudGrid>
        @foreach (var card in _workspaceCards)
        {
            <MudItem xs="12" md="6" xl="3">
                <MudPaper Class="pa-4 corebanker-workspace-card" Elevation="0">
                    <MudStack Spacing="1">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudAvatar Icon="@card.Icon" Color="@card.Color" Rounded="true" Size="Size.Medium" />
                            <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Color="Color.Default">@card.SecondaryStat</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.subtitle1">@card.Title</MudText>
                        <MudText Typo="Typo.h5">@card.PrimaryStat</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@card.Description</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo(card.Route))">Open @card.ActionLabel</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudTabs Rounded="true">
        <MudTabPanel Text="Loan Officer">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Portfolio</MudText>
                        <MudText Typo="Typo.h5">@_loans.Count</MudText>
                        <MudText Typo="Typo.body2">@($"Outstanding {_loans.Sum(loan => loan.OutstandingBalance ?? 0m):N2}")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Pending Approvals</MudText>
                        <MudText Typo="Typo.h5">@_approvals.Count(approval => approval.Status == "Pending")</MudText>
                        <MudText Typo="Typo.body2">@($"Appraised {_loans.Count(loan => loan.Status.Contains("APPRAISED", StringComparison.OrdinalIgnoreCase))}")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">PAR Watch</MudText>
                        <MudText Typo="Typo.h5">@_loans.Count(loan => !string.IsNullOrWhiteSpace(loan.ParBucket) && !string.Equals(loan.ParBucket, "CURRENT", StringComparison.OrdinalIgnoreCase))</MudText>
                        <MudText Typo="Typo.body2">@($"Active {_loans.Count(loan => loan.Status.Contains("ACTIVE", StringComparison.OrdinalIgnoreCase))}")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudTable T="CoreBanker.Services.LoanDto" Items="@_loans.Take(10)" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Loan</MudTh>
                    <MudTh>Customer</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Outstanding</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Loan">@context.Id</MudTd>
                    <MudTd DataLabel="Customer">@context.Cif</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Outstanding">@($"{context.OutstandingBalance ?? 0m:N2}")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Accountant">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">GL Accounts</MudText>
                        <MudText Typo="Typo.h5">@_glAccounts.Count</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Journal Entries</MudText>
                        <MudText Typo="Typo.h5">@_journalEntries.Count</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Imbalance Watch</MudText>
                        <MudText Typo="Typo.h5">@_journalEntries.Count(entry => entry.TotalDebit != entry.TotalCredit)</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudTable T="CoreBanker.Services.JournalEntryDto" Items="@_journalEntries.Take(10)" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Entry</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Debits</MudTh>
                    <MudTh>Credits</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Entry">@context.Reference</MudTd>
                    <MudTd DataLabel="Date">@context.CreatedAt.ToString("g")</MudTd>
                    <MudTd DataLabel="Debits">@($"{context.TotalDebit:N2}")</MudTd>
                    <MudTd DataLabel="Credits">@($"{context.TotalCredit:N2}")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Customer Service">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Active Clients</MudText>
                        <MudText Typo="Typo.h5">@_clients.Count(client => client.Status == "Active")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Tier 1 Clients</MudText>
                        <MudText Typo="Typo.h5">@_clients.Count(client => client.KycLevel == "Tier 1")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Open Accounts</MudText>
                        <MudText Typo="Typo.h5">@_accounts.Count(account => account.Status == "ACTIVE")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudTable T="CoreBanker.Services.ClientDto" Items="@_clients.Take(10)" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Client</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>KYC</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Client">@context.Name</MudTd>
                    <MudTd DataLabel="Type">@context.Type</MudTd>
                    <MudTd DataLabel="KYC">@context.KycLevel</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Compliance">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Audit Events</MudText>
                        <MudText Typo="Typo.h5">@_auditLogs.Count</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">Exceptions</MudText>
                        <MudText Typo="Typo.h5">@_auditLogs.Count(log => !string.Equals(log.Status, "SUCCESS", StringComparison.OrdinalIgnoreCase))</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.caption">High Risk Clients</MudText>
                        <MudText Typo="Typo.h5">@_clients.Count(client => client.RiskRating == "High")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudTable T="CoreBanker.Services.AuditLogDto" Items="@_auditLogs.Take(10)" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Action</MudTh>
                    <MudTh>User</MudTh>
                    <MudTh>Module</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Action">@context.Action</MudTd>
                    <MudTd DataLabel="User">@context.User</MudTd>
                    <MudTd DataLabel="Module">@context.Module</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudStack>

@code {
    private List<CoreBanker.Services.LoanDto> _loans = new();
    private List<CoreBanker.Services.ApprovalDto> _approvals = new();
    private List<CoreBanker.Services.GLAccountDto> _glAccounts = new();
    private List<CoreBanker.Services.JournalEntryDto> _journalEntries = new();
    private List<CoreBanker.Services.ClientDto> _clients = new();
    private List<CoreBanker.Services.AccountDto> _accounts = new();
    private List<CoreBanker.Services.AuditLogDto> _auditLogs = new();
    private string _message = string.Empty;
    private readonly List<WorkspaceViewCard> _workspaceCards = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        _message = string.Empty;
        try
        {
            var loansTask = LoanService.GetLoansAsync();
            var approvalsTask = ApprovalService.GetApprovalsAsync();
            var glTask = AccountingService.GetGLAccountsAsync();
            var journalsTask = AccountingService.GetJournalEntriesAsync();
            var clientsTask = ClientService.GetClientsAsync();
            var accountsTask = AccountService.GetAccountsAsync();
            var auditTask = AuditService.GetAuditLogsAsync(50);
            await Task.WhenAll(loansTask, approvalsTask, glTask, journalsTask, clientsTask, accountsTask, auditTask);

            _loans = loansTask.Result;
            _approvals = approvalsTask.Result;
            _glAccounts = glTask.Result;
            _journalEntries = journalsTask.Result;
            _clients = clientsTask.Result;
            _accounts = accountsTask.Result;
            _auditLogs = auditTask.Result;
            RebuildWorkspaceCards();
        }
        catch (CoreBanker.Services.ApiClientException ex)
        {
            _message = ex.Message;
        }
    }

    private void RebuildWorkspaceCards()
    {
        _workspaceCards.Clear();
        _workspaceCards.AddRange(
        [
            new("Loan Officer", $"{_loans.Count} loans", $"{_approvals.Count(approval => approval.Status == "Pending")} pending", "Origination, review, and PAR watch from one lending lens.", "/loans", "Loans", Icons.Material.Filled.RequestQuote, Color.Success),
            new("Accountant", $"{_journalEntries.Count} entries", $"{_glAccounts.Count} GL accounts", "Chart, journals, and imbalance visibility for finance operations.", "/accounting", "Accounting", Icons.Material.Filled.Calculate, Color.Info),
            new("Customer Service", $"{_clients.Count(client => client.Status == "Active")} active clients", $"{_accounts.Count(account => account.Status == "ACTIVE")} open accounts", "Front-office servicing across onboarding, KYC, and account care.", "/clients", "Clients", Icons.Material.Filled.SupportAgent, Color.Primary),
            new("Compliance", $"{_auditLogs.Count} events", $"{_auditLogs.Count(log => !string.Equals(log.Status, "SUCCESS", StringComparison.OrdinalIgnoreCase))} exceptions", "Audit visibility, controls, and exception follow-up.", "/audit", "Audit", Icons.Material.Filled.GppGood, Color.Warning)
        ]);
    }

    private sealed record WorkspaceViewCard(
        string Title,
        string PrimaryStat,
        string SecondaryStat,
        string Description,
        string Route,
        string ActionLabel,
        string Icon,
        Color Color);
}
