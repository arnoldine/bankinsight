@inject CoreBanker.Auth.IAuthStateProvider AuthStateProvider
@inject CoreBanker.Auth.AuthService AuthService
@inject NavigationManager Navigation

@if (AuthStateProvider.IsInitializing)
{
    <MudThemeProvider>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
            <MudPaper Class="pa-6 text-center" Elevation="4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4">Restoring your session</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Checking saved credentials and loading the CoreBanker workspace.</MudText>
            </MudPaper>
        </MudContainer>
    </MudThemeProvider>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @if (IsProtectedRoute(routeData.PageType) && !AuthStateProvider.IsAuthenticated)
            {
                Navigation.NavigateTo("/login", true);
            }
            else if (RequiresPermission(routeData.PageType, out var permission) && !AuthStateProvider.HasPermission(permission))
            {
                Navigation.NavigateTo($"/access-denied?required={Uri.EscapeDataString(permission)}", true);
            }
            else
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layouts.MainLayout)"/>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            }
        </Found>
    </Router>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
    }

    private static readonly Dictionary<Type, string> ProtectedPagePermissions = new()
    {
        [typeof(Pages.Dashboard)] = "dashboard.view",
        [typeof(Pages.Clients)] = "customers.view",
        [typeof(Pages.ClientsOnboard)] = "customers.create",
        [typeof(Pages.Accounts)] = "accounts.view",
        [typeof(Pages.Teller)] = "transactions.create",
        [typeof(Pages.Transactions)] = "transactions.view",
        [typeof(Pages.LoanManagement)] = "loans.view",
        [typeof(Pages.Approvals)] = "approvals.view",
        [typeof(Pages.Accounting)] = "gl.view",
        [typeof(Pages.Reporting)] = "reports.view",
        [typeof(Pages.Audit)] = "audit.view",
        [typeof(Pages.Security)] = "security.view",
        [typeof(Pages.SecurityOps)] = "security.view",
        [typeof(Pages.MigrationWorkbench)] = "migration.view",
        [typeof(Pages.BankingOSControl)] = "bankingos.view",
        [typeof(Pages.GroupLending)] = "groups.view",
        [typeof(Pages.Treasury)] = "treasury.view",
        [typeof(Pages.Vault)] = "vault.view",
        [typeof(Pages.OperationsRisk)] = "operations.view",
        [typeof(Pages.Products)] = "products.view",
        [typeof(Pages.Settings)] = "settings.view",
        [typeof(Pages.Statements)] = "statements.view",
        [typeof(Pages.WorkspaceViews)] = "workspaces.view",
        [typeof(Pages.Extensibility)] = "extensibility.view",
        [typeof(Pages.EndOfDay)] = "eod.view"
    };

    private bool IsProtectedRoute(Type pageType)
        => ProtectedPagePermissions.ContainsKey(pageType);

    private static bool RequiresPermission(Type pageType, out string permission)
        => ProtectedPagePermissions.TryGetValue(pageType, out permission!);
}
