@inject CoreBanker.Auth.IAuthStateProvider AuthStateProvider
@inject CoreBanker.Auth.AuthService AuthService
@inject NavigationManager Navigation

@if (AuthStateProvider.IsInitializing)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
        <MudPaper Class="pa-6 text-center" Elevation="4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-4">Restoring your session</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Checking saved credentials and loading the CoreBanker workspace.</MudText>
        </MudPaper>
    </MudContainer>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @if (IsProtectedRoute(routeData.PageType) && !AuthStateProvider.IsAuthenticated)
            {
                Navigation.NavigateTo("/login", true);
            }
            else if (RequiresPermission(routeData.PageType, out var permissions) && !permissions.Any(AuthStateProvider.HasPermission))
            {
                Navigation.NavigateTo($"/access-denied?required={Uri.EscapeDataString(string.Join(" | ", permissions))}", true);
            }
            else
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layouts.MainLayout)"/>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            }
        </Found>
    </Router>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
    }

    private static readonly Dictionary<Type, IReadOnlyList<string>> ProtectedPagePermissions = new()
    {
        [typeof(Pages.Dashboard)] = ["dashboard.view"],
        [typeof(Pages.Clients)] = ["customers.view"],
        [typeof(Pages.ClientsOnboard)] = ["customers.create"],
        [typeof(Pages.Accounts)] = ["accounts.view", "VIEW_ACCOUNTS"],
        [typeof(Pages.Teller)] = ["transactions.post", "transactions.create", "POST_TRANSACTIONS"],
        [typeof(Pages.Transactions)] = ["transactions.view", "VIEW_TRANSACTIONS"],
        [typeof(Pages.DigitalBanking)] = ["accounts.view", "VIEW_ACCOUNTS"],
        [typeof(Pages.LoanManagement)] = ["loans.view", "VIEW_LOANS"],
        [typeof(Pages.Approvals)] = ["approvals.view", "VIEW_APPROVALS", "workflow.view"],
        [typeof(Pages.Accounting)] = ["gl.view", "VIEW_GL", "MANAGE_GL"],
        [typeof(Pages.Reporting)] = ["reports.view", "VIEW_REPORTS"],
        [typeof(Pages.FintechPlatform)] = ["dashboard.view", "accounts.view", "VIEW_ACCOUNTS"],
        [typeof(Pages.Audit)] = ["audit.view"],
        [typeof(Pages.Security)] = ["audit.view", "users.manage", "MANAGE_USERS"],
        [typeof(Pages.SecurityOps)] = ["audit.view", "users.manage", "MANAGE_USERS"],
        [typeof(Pages.MigrationWorkbench)] = ["users.manage", "MANAGE_USERS"],
        [typeof(Pages.BankingOSControl)] = ["processes.view", "tasks.view", "processes.manage", "VIEW_WORKFLOWS", "MANAGE_WORKFLOWS"],
        [typeof(Pages.GroupLending)] = ["group-lending.view", "group-lending.reports.view", "VIEW_GROUPS"],
        [typeof(Pages.Treasury)] = ["gl.view", "VIEW_GL", "reports.risk"],
        [typeof(Pages.Vault)] = ["transactions.post", "POST_TRANSACTIONS", "gl.view"],
        [typeof(Pages.OperationsRisk)] = ["audit.view", "reports.risk", "gl.view"],
        [typeof(Pages.Products)] = ["loans.products.configure", "group-lending.products.configure", "VIEW_PRODUCTS", "MANAGE_PRODUCTS"],
        [typeof(Pages.Settings)] = ["VIEW_CONFIG", "MANAGE_CONFIG", "roles.manage", "MANAGE_ROLES", "users.manage", "MANAGE_USERS", "branches.manage", "VIEW_ROLES"],
        [typeof(Pages.Statements)] = ["reports.financial", "reports.view", "VIEW_REPORTS"],
        [typeof(Pages.WorkspaceViews)] = ["dashboard.view", "audit.view", "reports.view"],
        [typeof(Pages.Extensibility)] = ["processes.view", "tasks.view", "processes.manage", "VIEW_WORKFLOWS", "MANAGE_WORKFLOWS"],
        [typeof(Pages.EndOfDay)] = ["gl.post", "POST_JOURNAL", "gl.view", "VIEW_GL", "MANAGE_GL"]
    };

    private bool IsProtectedRoute(Type pageType)
        => ProtectedPagePermissions.ContainsKey(pageType);

    private static bool RequiresPermission(Type pageType, out IReadOnlyList<string> permissions)
        => ProtectedPagePermissions.TryGetValue(pageType, out permissions!);
}
